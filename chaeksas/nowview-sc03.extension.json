{
 "schema": 2,
 "id": "nowview-sc03",
 "version": "0.1.0",
 "name": "NowView SC03 통합 손익영향 검토 시스템",
 "description": "가상 부품사 NowView의 장면 3(SC03) 시스템 작업 — 장면 1 물량 감소와 장면 2 승인 단가의 통합 손익 계산·정합 검증, 부서 확인·쟁점 판단, 보고자료 확정, 수시 경영검토회의 결론·후보 포함/제외, 분석과제 배정·인수, 장면 4 인계. 숫자는 NowView 규칙 계산이 만든다. 본문마다 Chaeksas 실행 id({{run_id}})를 실어 데모 실행과 묶는다 — 실행 위치를 studio·center로 만든 데모 실행에서만 받는다. 키(Bearer)가 실행 위치를 말한다 — 운영 키는 Center, 시험용 키는 Studio(nowview-sc01·sc02와 같은 키). 주소의 기본은 운영계이고 로컬 Center는 「서버 주소」를 덮어쓴다(ADR-0097) — 실행기가 호스트에서 돌면 http://localhost:3000, docker 컨테이너에서 돌면 http://host.docker.internal:3000. 기록 작업은 결재에 답한 사람(answered_by)을 받는다.",
 "publisher": "NowView",
 "tier": "external",
 "requires_keys": [
  {
   "purpose": "run"
  }
 ],
 "service": {
  "protocol": "http-adapter",
  "base_url": "https://www.nowview.work",
  "adapter": {
   "allowed_hosts": [
    "www.nowview.work",
    "localhost",
    "host.docker.internal"
   ],
   "allow_private_network": true,
   "auth": {
    "type": "bearer"
   },
   "limits": {
    "timeout_s": 30,
    "max_response_kb": 256
   },
   "operations": [
    {
     "name": "open_review",
     "description": "검토건 열기 (S31·CT31) — 착수된 MR-2706-01인지 확인한다. 착수는 NowView 화면 명령이다",
     "modes": [
      "autonomous",
      "deterministic"
     ],
     "idempotent": true,
     "input_schema": {
      "type": "object",
      "required": [
       "demo_run_id"
      ],
      "properties": {
       "demo_run_id": {
        "type": "string"
       }
      }
     },
     "output_schema": {
      "type": "object",
      "properties": {
       "assignee_name": {
        "type": "string"
       },
       "review_id": {
        "type": "string"
       }
      }
     },
     "request": {
      "method": "POST",
      "path": "/api/engine/sc03/demo-runs/{{input.demo_run_id}}/operations/open_review",
      "body": {
       "chaeksas_run_id": "{{run_id}}",
       "chaeksas_node_id": "{{node_id}}"
      }
     },
     "response": {
      "output": {
       "assignee_name": "$.assignee_name",
       "review_id": "$.review_id"
      }
     }
    },
    {
     "name": "run_analysis",
     "description": "통합 분석 실행·저장 (S32·S33·CT31~CT33) — 승인 단가만 반영, 정합 검증 통과 시 보고 초안",
     "modes": [
      "autonomous",
      "deterministic"
     ],
     "idempotent": false,
     "input_schema": {
      "type": "object",
      "required": [
       "answered_by",
       "basis",
       "demo_run_id",
       "node_id"
      ],
      "properties": {
       "answered_by": {
        "type": "string"
       },
       "answered_via": {
        "type": [
         "string",
         "null"
        ]
       },
       "basis": {
        "type": "string"
       },
       "demo_run_id": {
        "type": "string"
       },
       "memo": {
        "type": [
         "string",
         "null"
        ]
       },
       "node_id": {
        "type": "string"
       }
      }
     },
     "output_schema": {
      "type": "object",
      "properties": {
       "error_message": {},
       "passed": {
        "type": "boolean"
       },
       "run_id": {
        "type": "string"
       }
      }
     },
     "request": {
      "method": "POST",
      "path": "/api/engine/sc03/demo-runs/{{input.demo_run_id}}/operations/run_analysis",
