{
  "schema": 2,
  "id": "nowview-sc02",
  "version": "0.1.0",
  "name": "NowView SC02 구매 단가 검토 시스템",
  "description": "가상 부품사 NowView의 장면 2(SC02) 시스템 작업 — 단가 인상 요청 검사·영향분석·협상 기록·기안 상신·결재 기록·대표 대상 판단·원가 등록·경영관리 인계. 숫자는 NowView 규칙 계산이 만든다. 본문마다 Chaeksas 실행 id({{run_id}})를 실어 데모 실행과 묶는다 — 실행 위치를 studio·center로 만든 데모 실행에서만 받는다. 키(Bearer)가 실행 위치를 말한다 — 운영 키는 Center, 시험용 키는 Studio(nowview-sc01과 같은 키). 주소의 기본은 운영계이고 로컬 Center는 「서버 주소」를 덮어쓴다(ADR-0097) — 실행기가 호스트에서 돌면 http://localhost:3000, docker 컨테이너에서 돌면 http://host.docker.internal:3000. 기록 작업은 결재에 답한 사람(answered_by)을 받는다.",
  "publisher": "NowView",
  "tier": "external",
  "requires_keys": [
    {
      "purpose": "run"
    }
  ],
  "service": {
    "protocol": "http-adapter",
    "base_url": "https://www.nowview.work",
    "adapter": {
      "allowed_hosts": [
        "www.nowview.work",
        "localhost",
        "host.docker.internal"
      ],
      "allow_private_network": true,
      "auth": {
        "type": "bearer"
      },
      "limits": {
        "timeout_s": 30,
        "max_response_kb": 256
      },
      "operations": [
        {
          "name": "screen_request",
          "description": "요청 자동 검사 (S01·CT21) — 필수값·KRW·VAT 제외·월초 적용·공급사-품목 매핑·기존가 = C01 부품 단가",
          "modes": [
            "autonomous",
            "deterministic"
          ],
          "idempotent": true,
          "input_schema": {
            "type": "object",
            "required": [
              "demo_run_id",
              "request_id"
            ],
            "properties": {
              "demo_run_id": {
                "type": "string"
              },
              "request_id": {
                "type": "string"
              }
            }
          },
          "output_schema": {
            "type": "object",
            "properties": {
              "error_count": {
                "type": "integer"
              },
              "passed": {
                "type": "boolean"
              }
            }
          },
          "request": {
            "method": "POST",
            "path": "/api/engine/sc02/demo-runs/{{input.demo_run_id}}/operations/screen_request",
            "body": {
              "chaeksas_run_id": "{{run_id}}",
              "chaeksas_node_id": "{{node_id}}",
              "request_id": "{{input.request_id}}"
            }
          },
          "response": {
            "output": {
              "error_count": "$.error_count",
              "passed": "$.passed"
            }
          }
        },
        {
          "name": "record_verification",
          "description": "요청 원문 확인 기록 — 확인완료면 요청안 단가 버전을 만들고, 보완요청이면 보완 대기",
          "modes": [
            "autonomous",
            "deterministic"
          ],
          "idempotent": false,
          "input_schema": {
            "type": "object",
            "required": [
              "answered_by",
              "demo_run_id",
              "node_id",
              "opinion",
              "request_id",
              "result"
            ],
            "properties": {
              "answered_by": {
                "type": "string"
              },
              "answered_via": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "demo_run_id": {
                "type": "string"
              },
              "node_id": {
                "type": "string"
              },
              "opinion": {
                "type": "string"
              },
              "request_id": {
                "type": "string"
              },
              "result": {
                "type": "string"
              }
            }
          },
          "output_schema": {
            "type": "object",
            "properties": {
              "error_message": {}
            }
          },
          "request": {
            "method": "POST",
            "path": "/api/engine/sc02/demo-runs/{{input.demo_run_id}}/operations/record_verification",
            "body": {
              "chaeksas_run_id": "{{run_id}}",
              "chaeksas_node_id": "{{node_id}}",
              "answered_by": "{{input.answered_by}}",
              "answered_via": "{{input.answered_via}}",
              "node_id": "{{input.node_id}}",
              "opinion": "{{input.opinion}}",
              "request_id": "{{input.request_id}}",
              "result": "{{input.result}}"
            }
          },
          "response": {
            "output": {
              "error_message": "$.error_message"
            }
          }
        },
        {
          "name": "record_report",
          "description": "팀장 구두보고 기록 (S02·CT22) — 별도 승인 단계가 아니다. 검토종결이면 장면 종결",
          "modes": [
            "autonomous",
            "deterministic"
          ],
          "idempotent": false,
          "input_schema": {
            "type": "object",
            "required": [
              "answered_by",
              "conclusion",
              "demo_run_id",
              "need",
              "node_id",
              "participants",
              "summary"
            ],
            "properties": {
              "answered_by": {
                "type": "string"
              },
              "answered_via": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "conclusion": {
                "type": "string"
              },
              "demo_run_id": {
                "type": "string"
              },
              "direction": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "need": {
                "type": "string"
              },
              "node_id": {
                "type": "string"
              },
              "participants": {
                "type": "string"
              },
