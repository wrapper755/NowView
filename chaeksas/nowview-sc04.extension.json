          "name": "open_review",
          "description": "검토건 열기 (S01·CT401) — 착수된 MR-2706-01인지 확인한다. 착수는 NowView 화면 명령이다",
          "modes": [
            "autonomous",
            "deterministic"
          ],
          "idempotent": true,
          "input_schema": {
            "type": "object",
            "required": [
              "demo_run_id"
            ],
            "properties": {
              "demo_run_id": {
                "type": "string"
              }
            }
          },
          "output_schema": {
            "type": "object",
            "properties": {
              "assignee_name": {
                "type": "string"
              },
              "review_id": {
                "type": "string"
              }
            }
          },
          "request": {
            "method": "POST",
            "path": "/api/engine/sc04/demo-runs/{{input.demo_run_id}}/operations/open_review",
            "body": {
              "chaeksas_run_id": "{{run_id}}",
              "chaeksas_node_id": "{{node_id}}"
            }
          },
          "response": {
