<?xml version="1.0" encoding="UTF-8"?>
<!--
  시나리오 2 장면 3 — 잔여 납기 위험의 경영검토와 대응 합의(D06~D08). 업무 흐름의 유일한 원천이다.

  **장면 2 인계(HAND-02)에서 이어진다** — 같은 사건(CASE-S2-01)의 COM-R만이다. 사이트의 「장면 열기」로
  NowView 일꾼이 이 프로세스를 기동한다(입력 `데모실행ID`·`사건ID`). 그림이 쥐는 것은 순서·사람 대기·
  분기뿐이다 — 회신 유효성, 두 전량 대안의 도착·여유·추가비·초과액, 전결 한도 대조는 일꾼의 규칙
  계산이다(NowView `engine/app/s2/sc03/calc.py`).

  단계 대응(업무설계표 01~07): 수행계획 변경 N03A 재진입은 **공통 BPM `platform.case-plan` 호출**(장면 2와
  같은 공통 BPM — A03이 v1 완료 항목을 보존하고 U06 원업무 참조·조건부 U07을 제안 → Y01 검사 → v2 적용)
  → 원업무 연결 U06(출하팀의 기존 운송 문의를 참조 — 새 문의를 만들지 않는다) → 회신·고객 소요 확인이
  아직이면 **메시지 「사건근거」를 기다린다**(상관 키 데모실행ID — NowView가 기간계의 새 근거를 보면
  보낸다) → 운송 대안 비교 N09(A01, 정기차 유지·전량 긴급차 두 안만) → **담당 팀장(H03) 권고·재보고 결재**
  (권고안 추가비가 전결 한도를 넘으면 재보고 ESC-03 → U07 활성, 넘지 않으면 팀장 전결 범위로 끝, 갱신 요청이면
  다시 연결) → **생산총괄 임원(H05) 결정 결재** N10(결정 시각에 근거가 바뀌었거나 회신 유효시각이 지났으면
  결정하지 않고 다시 연결·비교) → **출하 담당자(H04) 실행과제 인수 결재** → HAND-03(장면 4).

  사람 결재 셋이 모두 이 그림에 있다 — 서버 실행기가 호출 활동 안의 결재를 Center에 올리지 않아(BPM
  `server_runner/agent.py` `post_approvals`는 최상위 실행의 결재만 올린다) 경영검토를 공통 BPM으로 뽑지
  않았다. 결재에 답한 사람은 `answered_by_as`·`answered_via_as`로 받아 기록 작업에 싣는다. 기록이
  거절되면(권한·최신성·조건 미확인 안 권고) 오류 경계로 **같은 결재로 되돌아간다**. 결재 담당자 이름은
  NowView `app/platform/catalog.py`의 HOLDERS — 시험이 맞춰 본다(H03 = 생산팀장 · H04 = 출하담당 ·
  H05 = 생산임원은 가안, 구현명세 Q03). 공통 BPM 사본은 `libs/`에 있다(Studio 「설치」 — 판 고정).
  이 파일은 손으로 고쳐도 된다.
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:chk="urn:chaeksas:bpmn:1" id="Defs_s2_sc03">
  <bpmn:error id="Err_record" name="기록 거절" errorCode="TASK_FAILED"/>
  <bpmn:message id="Msg_sources" name="사건근거"/>
  <bpmn:process id="company1.s2.sc03" name="S2 SC03 잔여 납기 위험의 경영검토와 대응 합의" isExecutable="true">
    <bpmn:extensionElements>
      <chk:process>{"run_location": "server", "extensions": [{"id": "external", "version": "&gt;=0.11.0,&lt;1"}], "inputs": [{"name": "데모실행ID", "type": "string", "required": true}, {"name": "사건ID", "type": "string", "required": true}]}</chk:process>
    </bpmn:extensionElements>
    <bpmn:startEvent id="Start" name="잔여 위험 인수 — HAND-02 (COM-R)"/>
    <bpmn:callActivity id="Call_CasePlan" name="수행계획 변경 (공통 BPM — N03A 재진입)" calledElement="platform.case-plan">
      <bpmn:extensionElements>
        <chk:call>{"input": {"데모실행ID": "데모실행ID", "사건ID": "사건ID"}, "output": {"수행계획ID": "수행계획ID", "계획검사": "계획검사", "검사사유": "검사사유"}}</chk:call>
      </bpmn:extensionElements>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Gw_Plan" name="수행계획 v2 적용됐나" default="Flow_plan_blocked"/>
    <bpmn:serviceTask id="Task_Link" name="기존 운송 문의 연결 (U06)">
      <bpmn:extensionElements>
        <chk:serviceCall>{"app_id": "external", "operation": "link_transport_work", "input": {"demo_run_id": "데모실행ID", "case_id": "사건ID"}, "output": {"연결ID": "link_id", "연결준비": "ready", "회신상태": "reply_state", "연결사유": "reason"}}</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Ready" name="회신·고객 조건이 다 왔나" default="Flow_wait"/>
    <bpmn:receiveTask id="Wait_Sources" name="운송사 회신·고객 소요 확인 대기" messageRef="Msg_sources">
      <bpmn:extensionElements>
        <chk:receive>{"message": "사건근거", "correlation": "데모실행ID", "payload": ["근거ID"]}</chk:receive>
      </bpmn:extensionElements>
    </bpmn:receiveTask>
    <bpmn:serviceTask id="Task_Compare" name="운송 대안 비교 (A01 — N09)">
      <bpmn:extensionElements>
        <chk:serviceCall>{"app_id": "external", "operation": "compare_transport_options", "input": {"demo_run_id": "데모실행ID", "case_id": "사건ID"}, "output": {"비교ID": "comparison_id", "비교판": "version", "긴급판정": "express_verdict", "초과액": "excess"}}</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="Approve_Recommend" name="운송 대안 권고·재보고 (담당 팀장 H03)">
      <bpmn:extensionElements>
        <chk:approval>{"title": "UI-B02 운송 대안 권고·재보고 — 담당 팀장(H03)", "answered_by_as": "권고자", "answered_via_as": "권고경로", "assignees": ["배정훈"], "description": "연결된 운송사 회신과 영업이 확인한 고객 조건으로 계산한 두 전량 대안(정기차 유지 · 전량 긴급차)을 보고 권고안과 근거를 남긴다. 권고안의 추가비가 팀장 전결 한도를 넘으면 생산총괄 임원에게 재보고되고(U07), 한도 안이면 팀장 전결 범위다 — 기준은 보고할 사람을 정할 뿐 안을 고르지 않는다. 회신이 없거나 예약 유효시각이 지났거나 전량이 안 되는 안은 권고할 수 없다 — 「갱신요청」으로 새 회신을 기다린다. 「가능」 회신은 예약 확정이 아니다.", "show": ["데모실행ID", "사건ID", "수행계획ID", "연결ID", "회신상태", "비교ID", "비교판", "긴급판정", "초과액", "error_message"], "fields": [{"key": "권고안", "label": "권고안 (ALT-EXP 전량 긴급차 · ALT-REG 정기차 유지 · 갱신요청)", "type": "choice", "required": true, "choices": ["ALT-EXP", "ALT-REG", "갱신요청"]}, {"key": "비교버전", "label": "본 비교 버전", "type": "text", "required": true}, {"key": "권고사유", "label": "권고 사유(근거)", "type": "text", "required": true}]}</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="Record_Recommend" name="권고·재보고 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{"app_id": "external", "operation": "recommend_transport_option", "input": {"demo_run_id": "데모실행ID", "case_id": "사건ID", "version": "비교버전", "recommended": "권고안", "reason": "권고사유", "answered_by": "권고자", "answered_via": "권고경로"}, "output": {"권고결과": "result", "재보고ID": "escalation_id", "error_message": "error_message"}}</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Escalate" name="재보고인가" default="Flow_within"/>
    <bpmn:userTask id="Approve_Decision" name="경영검토 결정 (생산총괄 임원 H05 — N10)">
      <bpmn:extensionElements>
        <chk:approval>{"title": "UI-B05 경영검토 — 고객 납기를 위해 추가비용을 부담할 것인가 (H05)", "answered_by_as": "결정자", "answered_via_as": "결정경로", "assignees": ["권태윤"], "description": "정기차 유지(추가비 0원 · 약정 대비 부족)와 전량 긴급차(추가비 · 약정 전 도착 전망)를 비교해 선택하고, 사유와 총액 한도를 한 번에 남긴다. 결정이 실행 조건이 된다 — 출하 담당자가 예약 유효시각 전에 차량을 확보하고, 미확보·한도 초과·약정 이후 도착 전망이면 즉시 재보고한다. 같은 결정에 지출 재결재 단계는 없다. 결정 시각에 회신이 바뀌었거나 예약 유효시각이 지났으면 결정하지 않고 다시 비교한다.", "show": ["데모실행ID", "사건ID", "재보고ID", "비교ID", "비교판", "긴급판정", "초과액", "error_message"], "fields": [{"key": "결정", "label": "선택 (ALT-EXP 전량 긴급차 · ALT-REG 정기차 유지)", "type": "choice", "required": true, "choices": ["ALT-EXP", "ALT-REG"]}, {"key": "결정비교버전", "label": "본 비교 버전", "type": "text", "required": true}, {"key": "결정사유", "label": "결정 사유", "type": "text", "required": true}, {"key": "결정한도", "label": "총 추가비 한도(원)", "type": "text", "required": true}]}</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="Record_Decision" name="경영검토 결정 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{"app_id": "external", "operation": "record_transport_decision", "input": {"demo_run_id": "데모실행ID", "case_id": "사건ID", "version": "결정비교버전", "decision": "결정", "reason": "결정사유", "limit": "결정한도", "answered_by": "결정자", "answered_via": "결정경로"}, "output": {"결정결과": "result", "결정ID": "decision_id", "과제ID": "action_id", "error_message": "error_message"}}</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Decision" name="결정 당시 근거가 유효했나" default="Flow_decided"/>
    <bpmn:userTask id="Approve_Accept" name="실행과제 인수 (출하 담당자 H04)">
      <bpmn:extensionElements>
        <chk:approval>{"title": "UI-B05 실행과제 인수 — 출하 담당자(H04)", "answered_by_as": "인수자", "answered_via_as": "인수경로", "assignees": ["출하담당"], "description": "임원 결정의 조건(차량 대수·총 추가비 한도·예약 유효시각)과 재보고 조건을 함께 인수한다. 인수는 지출 재승인이 아니다 — 예약·출발·도착은 아직 미확정이고 실제 값은 장면 4에서 연결한다. 미확보·한도 초과·약정 이후 도착 전망이면 즉시 생산총괄 임원에게 재보고한다.", "show": ["데모실행ID", "사건ID", "결정ID", "과제ID", "error_message"], "fields": [{"key": "인수결정", "label": "실행과제 인수", "type": "choice", "required": true, "choices": ["인수"]}, {"key": "인수의견", "label": "인수 의견", "type": "text", "required": false}]}</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="Record_Accept" name="실행과제 인수 기록 — HAND-03">
      <bpmn:extensionElements>
        <chk:serviceCall>{"app_id": "external", "operation": "accept_transport_action", "input": {"demo_run_id": "데모실행ID", "case_id": "사건ID", "decision": "인수결정", "comment": "인수의견", "answered_by": "인수자", "answered_via": "인수경로"}, "output": {"과제상태": "state", "인계ID": "handoff_id", "error_message": "error_message"}}</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End" name="결정 완료 · 과제 인수 — 장면 4(HAND-03), 예약·실제 인수 미확정"/>
    <bpmn:endEvent id="End_WithinAuthority" name="팀장 전결 범위 — 경영검토 없음"/>
    <bpmn:endEvent id="End_PlanBlocked" name="수행계획 v2 적용 차단 — v1 유지"/>
    <bpmn:boundaryEvent id="Bnd_Record_Recommend" name="기록 거절" attachedToRef="Record_Recommend">
      <bpmn:errorEventDefinition errorRef="Err_record"/>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Bnd_Record_Decision" name="기록 거절" attachedToRef="Record_Decision">
      <bpmn:errorEventDefinition errorRef="Err_record"/>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Bnd_Record_Accept" name="기록 거절" attachedToRef="Record_Accept">
      <bpmn:errorEventDefinition errorRef="Err_record"/>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_start" sourceRef="Start" targetRef="Call_CasePlan"/>
    <bpmn:sequenceFlow id="Flow_planned" sourceRef="Call_CasePlan" targetRef="Gw_Plan"/>
    <bpmn:sequenceFlow id="Flow_plan_applied" name="적용" sourceRef="Gw_Plan" targetRef="Task_Link">
      <bpmn:conditionExpression>계획검사 == 'PASS'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_plan_blocked" name="차단" sourceRef="Gw_Plan" targetRef="End_PlanBlocked"/>
    <bpmn:sequenceFlow id="Flow_linked" sourceRef="Task_Link" targetRef="Gw_Ready"/>
    <bpmn:sequenceFlow id="Flow_ready" name="회신 유효 · 고객 확인" sourceRef="Gw_Ready" targetRef="Task_Compare">
      <bpmn:conditionExpression>연결준비</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_wait" name="대기" sourceRef="Gw_Ready" targetRef="Wait_Sources"/>
    <bpmn:sequenceFlow id="Flow_arrived" name="근거 수신 — 다시 연결" sourceRef="Wait_Sources" targetRef="Task_Link"/>
    <bpmn:sequenceFlow id="Flow_compared" sourceRef="Task_Compare" targetRef="Approve_Recommend"/>
    <bpmn:sequenceFlow id="Flow_Approve_Recommend_answered" sourceRef="Approve_Recommend" targetRef="Record_Recommend"/>
    <bpmn:sequenceFlow id="Flow_recommend_recorded" sourceRef="Record_Recommend" targetRef="Gw_Escalate"/>
    <bpmn:sequenceFlow id="Flow_escalated" name="한도 초과 — 재보고(U07)" sourceRef="Gw_Escalate" targetRef="Approve_Decision">
      <bpmn:conditionExpression>권고결과 == 'ESCALATED'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_refresh" name="갱신 요청 — 새 회신으로 다시" sourceRef="Gw_Escalate" targetRef="Task_Link">
      <bpmn:conditionExpression>권고결과 == 'REFRESH'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_within" name="전결 범위" sourceRef="Gw_Escalate" targetRef="End_WithinAuthority"/>
    <bpmn:sequenceFlow id="Flow_Approve_Decision_answered" sourceRef="Approve_Decision" targetRef="Record_Decision"/>
    <bpmn:sequenceFlow id="Flow_decision_recorded" sourceRef="Record_Decision" targetRef="Gw_Decision"/>
    <bpmn:sequenceFlow id="Flow_stale" name="근거 변경·유효시각 경과 — 다시 연결·비교" sourceRef="Gw_Decision" targetRef="Task_Link">
      <bpmn:conditionExpression>결정결과 == 'STALE'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_decided" sourceRef="Gw_Decision" targetRef="Approve_Accept"/>
    <bpmn:sequenceFlow id="Flow_Approve_Accept_answered" sourceRef="Approve_Accept" targetRef="Record_Accept"/>
    <bpmn:sequenceFlow id="Flow_accepted" sourceRef="Record_Accept" targetRef="End"/>
    <bpmn:sequenceFlow id="Flow_Record_Recommend_rejected" name="기록 거절 — 다시 답한다" sourceRef="Bnd_Record_Recommend" targetRef="Approve_Recommend"/>
    <bpmn:sequenceFlow id="Flow_Record_Decision_rejected" name="기록 거절 — 다시 답한다" sourceRef="Bnd_Record_Decision" targetRef="Approve_Decision"/>
    <bpmn:sequenceFlow id="Flow_Record_Accept_rejected" name="기록 거절 — 다시 답한다" sourceRef="Bnd_Record_Accept" targetRef="Approve_Accept"/>
  </bpmn:process>
</bpmn:definitions>
