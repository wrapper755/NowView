<?xml version="1.0" encoding="UTF-8"?>
<!--
  시나리오 2 장면 2 — 정형통제 실행과 주문별 분기(N03A~N08). 업무 흐름의 유일한 원천이다.

  **장면 1 인계(HAND-01)에서 이어진다** — 같은 사건(CASE-S2-01)이다. 사이트의 「장면 열기」로 NowView 일꾼이 이 프로세스를
  기동한다(입력 `데모실행ID`·`사건ID`). 그림이 쥐는 것은 순서·사람 대기·분기뿐이다 — 변경안의 시각·점검, 반영본 대조, 출하
  준비·정기차·납기 여유는 일꾼의 규칙 계산이다(NowView `engine/app/s2/sc02/calc.py`).

  단계 대응(업무설계표 01~07): 수행계획 구성 N03A는 **공통 BPM `platform.case-plan` 호출**(A03 제안 → Y01 검사 → 적용 —
  위임 범위 안이면 구성 승인 없음, 필수 확인을 뺀 조합은 차단) → 변경안 작성 N04(A02) → **생산관리 책임자(H03) 확인 N05 —
  사람 결재는 이것 하나다**(두 주문을 포함한 변경안 한 버전, 보완 요청이면 원계획 유지) → 반영 N06(확인 유효성·원계획 버전을
  다시 검사, 바뀌었으면 새 판을 써서 다시 확인) → 재조회 대조(원천 조회로 미반영이 확인된 주문만 같은 실행키로 다시) →
  주문별 재평가 N07 → 잔여 위험이 있으면 장면 3 운송 확인으로 인계 N08. 확인 뒤 반영·재조회는 자동이고 재승인이 없다.

  결재에 답한 사람은 `answered_by_as`·`answered_via_as`로 받아 기록 작업에 싣는다. 기록이 거절되면(권한·최신성·확정 불가
  변경안) 오류 경계로 **같은 결재로 되돌아간다**. 결재 담당자 이름은 NowView `app/platform/catalog.py`의 HOLDERS — 시험이
  맞춰 본다(H03 = 생산팀장은 가안, 구현명세 Q03). 공통 BPM 사본은 `libs/`에 있다(Studio 「설치」 — 판 고정).
  이 파일은 손으로 고쳐도 된다.
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:chk="urn:chaeksas:bpmn:1" id="Defs_s2_sc02">
  <bpmn:error id="Err_record" name="기록 거절" errorCode="TASK_FAILED"/>
  <bpmn:process id="company1.s2.sc02" name="S2 SC02 정형통제 실행과 주문별 분기" isExecutable="true">
    <bpmn:extensionElements>
      <chk:process>{"run_location": "server", "extensions": [{"id": "external", "version": "&gt;=0.10.0,&lt;1"}], "inputs": [{"name": "데모실행ID", "type": "string", "required": true}, {"name": "사건ID", "type": "string", "required": true}]}</chk:process>
    </bpmn:extensionElements>
    <bpmn:startEvent id="Start" name="사건 인계 — 수행계획 구성 대기(N03A)"/>
    <bpmn:callActivity id="Call_CasePlan" name="수행계획 구성 (공통 BPM — N03A)" calledElement="platform.case-plan">
      <bpmn:extensionElements>
        <chk:call>{"input": {"데모실행ID": "데모실행ID", "사건ID": "사건ID"}, "output": {"수행계획ID": "수행계획ID", "계획검사": "계획검사", "검사사유": "검사사유"}}</chk:call>
      </bpmn:extensionElements>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Gw_Plan" name="수행계획 적용됐나" default="Flow_plan_blocked"/>
    <bpmn:serviceTask id="Task_Draft" name="생산계획 변경안 작성 (A02 — N04)">
      <bpmn:extensionElements>
        <chk:serviceCall>{"app_id": "external", "operation": "draft_production_change", "input": {"demo_run_id": "데모실행ID", "case_id": "사건ID"}, "output": {"변경안ID": "draft_id", "변경안식별값": "content_hash", "점검결과": "check", "점검위반수": "issues", "점검사유": "reason"}}</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="Approve_Change" name="생산계획 변경 확인 (H03 — N05)">
      <bpmn:extensionElements>
        <chk:approval>{"title": "UI-B04 생산계획 변경안 확인 — 생산관리 책임자(H03)", "answered_by_as": "확인자", "answered_via_as": "확인경로", "assignees": ["배정훈"], "description": "S·R 두 주문을 포함한 변경안 한 버전을 확인한다. 배정수량·빈 라인 시간·품질 확인시간·다른 주문 영향을 보고 확정하거나 보완을 요청한다. R의 운송 위험이 남아도 생산 가능시간은 확정할 수 있다 — 이 확인은 긴급 운송 승인이나 고객 납기 보장이 아니다. 보완 요청이면 원계획을 유지한다. 확정 뒤 반영·재조회는 자동이다.", "show": ["데모실행ID", "사건ID", "수행계획ID", "변경안ID", "변경안식별값", "점검결과", "점검사유", "error_message"], "fields": [{"key": "확인결정", "label": "변경안 확인", "type": "choice", "required": true, "choices": ["확정", "보완요청"]}, {"key": "확인버전", "label": "확인 대상 변경안 버전", "type": "text", "required": true}, {"key": "확인의견", "label": "확인 의견(보완 요청이면 사유)", "type": "text", "required": true}]}</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="Record_Approve_Change" name="생산계획 변경 확인 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{"app_id": "external", "operation": "confirm_production_change", "input": {"demo_run_id": "데모실행ID", "case_id": "사건ID", "version": "확인버전", "content_hash": "변경안식별값", "decision": "확인결정", "comment": "확인의견", "answered_by": "확인자", "answered_via": "확인경로"}, "output": {"확인ID": "approval_id", "확인상태": "state", "error_message": "error_message"}}</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Confirm" name="확인 결과" default="Flow_confirmed"/>
    <bpmn:serviceTask id="Task_Apply" name="확정안 반영 (N06)">
      <bpmn:extensionElements>
        <chk:serviceCall>{"app_id": "external", "operation": "apply_production_change", "input": {"demo_run_id": "데모실행ID", "case_id": "사건ID"}, "output": {"반영결과": "result", "반영수": "applied", "결과미확인수": "unknown"}}</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Apply" name="확인이 아직 유효한가" default="Flow_applied"/>
    <bpmn:serviceTask id="Task_Requery" name="생산계획 재조회·대조 (N06)">
      <bpmn:extensionElements>
        <chk:serviceCall>{"app_id": "external", "operation": "requery_production_plan", "input": {"demo_run_id": "데모실행ID", "case_id": "사건ID"}, "output": {"대조결과": "result", "대조일치수": "matched", "재처리": "retry"}}</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Requery" name="미반영 확인분이 있나" default="Flow_requeried"/>
    <bpmn:serviceTask id="Task_Reassess" name="주문별 납기 재평가 (N07)">
      <bpmn:extensionElements>
        <chk:serviceCall>{"app_id": "external", "operation": "reassess_delivery_risk", "input": {"demo_run_id": "데모실행ID", "case_id": "사건ID"}, "output": {"판정ID": "assessment_id", "판정판": "version", "잔여위험": "residual", "관찰수": "observe", "운송확인수": "transport", "보류수": "hold"}}</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Residual" name="잔여 위험이 있나" default="Flow_no_residual"/>
    <bpmn:serviceTask id="Task_Handoff" name="운송 확인 인계 (N08)">
      <bpmn:extensionElements>
        <chk:serviceCall>{"app_id": "external", "operation": "hand_off_residual_risk", "input": {"demo_run_id": "데모실행ID", "case_id": "사건ID"}, "output": {"인계ID": "handoff_id", "다음단계": "next_node"}}</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End" name="잔여 위험 인계 — 장면 3 운송 확인(N09), 사건 진행 중"/>
    <bpmn:endEvent id="End_Observe" name="잔여 위험 없음 — 인수 관찰"/>
    <bpmn:endEvent id="End_Rework" name="보완 요청 — 원계획 유지"/>
    <bpmn:endEvent id="End_PlanBlocked" name="수행계획 적용 차단 — 생산계획 미변경"/>
    <bpmn:boundaryEvent id="Bnd_Record_Approve_Change" name="기록 거절" attachedToRef="Record_Approve_Change">
      <bpmn:errorEventDefinition errorRef="Err_record"/>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_start" sourceRef="Start" targetRef="Call_CasePlan"/>
    <bpmn:sequenceFlow id="Flow_planned" sourceRef="Call_CasePlan" targetRef="Gw_Plan"/>
    <bpmn:sequenceFlow id="Flow_plan_applied" name="적용" sourceRef="Gw_Plan" targetRef="Task_Draft">
      <bpmn:conditionExpression>계획검사 == 'PASS'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_plan_blocked" name="차단" sourceRef="Gw_Plan" targetRef="End_PlanBlocked"/>
    <bpmn:sequenceFlow id="Flow_drafted" sourceRef="Task_Draft" targetRef="Approve_Change"/>
    <bpmn:sequenceFlow id="Flow_Approve_Change_answered" sourceRef="Approve_Change" targetRef="Record_Approve_Change"/>
    <bpmn:sequenceFlow id="Flow_confirm_recorded" sourceRef="Record_Approve_Change" targetRef="Gw_Confirm"/>
    <bpmn:sequenceFlow id="Flow_rework" name="보완 요청" sourceRef="Gw_Confirm" targetRef="End_Rework">
      <bpmn:conditionExpression>확인결정 == '보완요청'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_confirmed" name="확정" sourceRef="Gw_Confirm" targetRef="Task_Apply"/>
    <bpmn:sequenceFlow id="Flow_apply_done" sourceRef="Task_Apply" targetRef="Gw_Apply"/>
    <bpmn:sequenceFlow id="Flow_stale" name="확인 후 전제 변경 — 새 판 작성·재확인" sourceRef="Gw_Apply" targetRef="Task_Draft">
      <bpmn:conditionExpression>반영결과 == 'STALE'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_applied" sourceRef="Gw_Apply" targetRef="Task_Requery"/>
    <bpmn:sequenceFlow id="Flow_requery_done" sourceRef="Task_Requery" targetRef="Gw_Requery"/>
    <bpmn:sequenceFlow id="Flow_retry" name="미반영 확인 — 같은 실행키로 다시" sourceRef="Gw_Requery" targetRef="Task_Apply">
      <bpmn:conditionExpression>재처리</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_requeried" sourceRef="Gw_Requery" targetRef="Task_Reassess"/>
    <bpmn:sequenceFlow id="Flow_reassessed" sourceRef="Task_Reassess" targetRef="Gw_Residual"/>
    <bpmn:sequenceFlow id="Flow_residual" name="운송 확인 필요" sourceRef="Gw_Residual" targetRef="Task_Handoff">
      <bpmn:conditionExpression>잔여위험</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_no_residual" name="모두 관찰" sourceRef="Gw_Residual" targetRef="End_Observe"/>
    <bpmn:sequenceFlow id="Flow_handed" sourceRef="Task_Handoff" targetRef="End"/>
    <bpmn:sequenceFlow id="Flow_Record_Approve_Change_rejected" name="기록 거절 — 다시 답한다" sourceRef="Bnd_Record_Approve_Change" targetRef="Approve_Change"/>
  </bpmn:process>
</bpmn:definitions>
