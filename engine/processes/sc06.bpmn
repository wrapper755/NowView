<?xml version="1.0" encoding="UTF-8"?>
<!--
  SC06 — 과제 완료와 성과 실현 검토(장면 6)의 **확인 절차**. 업무 흐름의 유일한 원천이다(장면 1~5와 같다).

  BPM이 쥐는 것: 순서 · 사람 대기(담당 임원 성과 근거 확인 2 · 경영관리 종합 확인 · 보고 결론 작성 · 보고본 확정 · 대표 보고) ·
  분기(종합 확인의 재확인 요청 · 확정의 보완 요청). 쥐지 않는 것: 숫자 — Q4 기대 대비 확인 효과·원인·보조 손익은 적재 때 규칙
  계산이 만들었고(`app/sc06/calc.py`), 확정 작업이 보고 결론의 숫자를 묶인 산정과 대조한다(CT611).

  단계 대응(업무설계표 SC06-S11~S13): 확인 착수(화면 명령 — 이 그림은 착수된 검토건을 연다) → 담당 임원 확인 CF61-P(생산, ACT41)
  ∥ CF61-B(구매, ACT42·43·JDG61) → 경영관리 종합 확인 CF61-F(재확인 요청이면 두 확인을 다시) → 보고 결론 TXT61(경영관리 담당)
  → 보고본 확정 CF61-R + 남는 사항 NOTE61(보완 요청이면 결론을 다시) → 대표 월간 보고 CF61-M. 보고 확정은 과제 실행·예산 승인이
  아니다 — 끝나도 RISK61 OPEN · PROP61 PROPOSED이고 FC51·Target은 그대로다.

  **Studio 시험 실행·Center 서버 실행에서 돈다**(장면 1~5 N1~N6과 같은 틀). 서비스 태스크는 외부 확장 `nowview-sc06`
  (`chaeksas/nowview-sc06.extension.json`)의 HTTP 작업이고 본문마다 `{{run_id}}`로 데모 실행을 묶는다. 결재에 답한 사람은
  `answered_by_as`·`answered_via_as`로 받아 기록 작업에 싣는다. 기록이 거절되면 오류 경계로 **같은 결재로 되돌아간다**.
  병렬 갈래끼리 변수가 겹치지 않게 폼 칸 이름에 부서를 붙였다(생산확인내용 · 구매확인내용).
  역할은 `app/sc06/domain.py`의 NODE_ROLES, 결재 담당자 이름은 `chk:approval.assignees` — 시험이 맞춰 본다.
  이 파일은 손으로 고쳐도 된다.
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:chk="urn:chaeksas:bpmn:1" id="Defs_sc06">
  <bpmn:error id="Err_record" name="기록 거절" errorCode="TASK_FAILED"/>
  <bpmn:process id="autopart1.sc06" name="SC06 과제 완료·성과 실현 검토 확인" isExecutable="true">
    <bpmn:extensionElements>
      <chk:process>{"run_location": "server", "extensions": [{"id": "nowview-sc06", "version": "&gt;=0.1.0,&lt;1"}], "inputs": [{"name": "데모실행ID", "type": "string", "required": true}]}</chk:process>
    </bpmn:extensionElements>
    <bpmn:startEvent id="Start" name="확인 착수"/>
    <bpmn:serviceTask id="Task_Open" name="검토건 열기">
      <bpmn:extensionElements>
        <chk:serviceCall>{"app_id": "nowview-sc06", "operation": "open_review", "input": {"demo_run_id": "데모실행ID"}, "output": {"검토ID": "review_id", "보고버전": "report_version", "산정버전": "calculation_version"}}</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="Confirm_Prod" name="생산 임원 성과 근거 확인">
      <bpmn:extensionElements>
        <chk:approval>{"title": "U601 담당 임원 성과 근거 확인 — 생산(ACT41)", "answered_by_as": "생산확인자", "answered_via_as": "생산확인경로", "assignees": ["권태윤"], "description": "ACT41 완료와 Q4 효과를 이 보고 버전·산정 버전 기준으로 확인한다. 확인은 그 과제의 근거 확인이지 보고 확정이 아니다.", "show": ["보고버전", "산정버전", "error_message"], "fields": [{"key": "생산확인내용", "label": "확인 내용·범위", "type": "text", "required": true}, {"key": "생산확인근거", "label": "근거 ID(; 로 구분)", "type": "text", "required": true}]}</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="Record_Confirm_Prod" name="생산 임원 확인 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{"app_id": "nowview-sc06", "operation": "confirm_owner", "input": {"demo_run_id": "데모실행ID", "node_id": "'Confirm_Prod'", "record_id": "'CF61-P'", "content": "생산확인내용", "refs": "생산확인근거", "answered_by": "생산확인자", "answered_via": "생산확인경로"}, "output": {"error_message": "error_message"}}</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="Confirm_Buy" name="구매 임원 성과 근거 확인">
      <bpmn:extensionElements>
        <chk:approval>{"title": "U601 담당 임원 성과 근거 확인 — 구매(ACT42·43 · JDG61)", "answered_by_as": "구매확인자", "answered_via_as": "구매확인경로", "assignees": ["문지후"], "description": "ACT42·43 효과·원인과 JDG61(일부 보완 중·검토 가능) 판단을 확인한다. 미비 항목·보완 기한은 지우지 않는다.", "show": ["보고버전", "산정버전", "error_message"], "fields": [{"key": "구매확인내용", "label": "확인 내용·범위", "type": "text", "required": true}, {"key": "구매확인근거", "label": "근거 ID(; 로 구분)", "type": "text", "required": true}]}</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="Record_Confirm_Buy" name="구매 임원 확인 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{"app_id": "nowview-sc06", "operation": "confirm_owner", "input": {"demo_run_id": "데모실행ID", "node_id": "'Confirm_Buy'", "record_id": "'CF61-B'", "content": "구매확인내용", "refs": "구매확인근거", "answered_by": "구매확인자", "answered_via": "구매확인경로"}, "output": {"error_message": "error_message"}}</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="Review_Finance" name="경영관리 종합 확인">
      <bpmn:extensionElements>
        <chk:approval>{"title": "U601 경영관리 종합 확인 — 분기 기준·중복·합계·잔여 위험·후속 책임", "answered_by_as": "종합확인자", "answered_via_as": "종합확인경로", "assignees": ["강민서"], "description": "두 담당 임원 확인이 같은 보고 버전인지, 합계·잔여 위험·후속 책임(FUP61·PROP61)을 확인한다. 재확인 요청이면 두 확인을 다시 받는다.", "show": ["보고버전", "산정버전", "error_message"], "fields": [{"key": "종합결정", "label": "종합 확인", "type": "choice", "required": true, "choices": ["확인", "재확인요청"]}, {"key": "종합내용", "label": "확인 내용(재확인 요청이면 사유)", "type": "text", "required": true}, {"key": "종합근거", "label": "근거 ID(; 로 구분)", "type": "text", "required": false}]}</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="Record_Review_Finance" name="경영관리 종합 확인 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{"app_id": "nowview-sc06", "operation": "review_finance", "input": {"demo_run_id": "데모실행ID", "node_id": "'Review_Finance'", "decision": "종합결정", "content": "종합내용", "refs": "종합근거", "answered_by": "종합확인자", "answered_via": "종합확인경로"}, "output": {"error_message": "error_message"}}</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="Draft_Conclusion" name="보고 결론 작성">
      <bpmn:extensionElements>
        <chk:approval>{"title": "U602 보고 결론 작성 — 성과·남는 차이·후속 대응", "answered_by_as": "결론작성자", "answered_via_as": "결론작성경로", "assignees": ["정하윤"], "description": "결론 문장의 「…백만원」 숫자는 묶인 산정과 대조된다(확정에서 막힌다). 기대·확인 합계와 ACT42 기대·확인만 쓸 수 있다.", "show": ["보고버전", "산정버전", "error_message"], "fields": [{"key": "보고결론", "label": "보고 결론", "type": "text", "required": true}, {"key": "결론근거", "label": "근거 ID(; 로 구분)", "type": "text", "required": false}]}</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="Record_Draft_Conclusion" name="보고 결론 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{"app_id": "nowview-sc06", "operation": "draft_conclusion", "input": {"demo_run_id": "데모실행ID", "node_id": "'Draft_Conclusion'", "content": "보고결론", "refs": "결론근거", "answered_by": "결론작성자", "answered_via": "결론작성경로"}, "output": {"error_message": "error_message"}}</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="Finalize_Report" name="보고본 확정">
      <bpmn:extensionElements>
        <chk:approval>{"title": "U602 대표 월간 보고본 확정 — 보고 편성 책임", "answered_by_as": "확정자", "answered_via_as": "확정경로", "assignees": ["강민서"], "description": "확인 세 단계가 같은 보고 버전이고 결론 숫자가 묶인 산정과 같아야 확정된다. 확정은 과제 실행·예산 승인이 아니다. 보완 요청이면 결론을 다시 쓴다.", "show": ["보고버전", "산정버전", "error_message"], "fields": [{"key": "확정결정", "label": "확정", "type": "choice", "required": true, "choices": ["확정", "보완요청"]}, {"key": "확정내용", "label": "확정 내용(보완 요청이면 사유)", "type": "text", "required": true}, {"key": "남는사항", "label": "남는 사항 — 보완 기한·다음 보고·미산정(확정이면 필수)", "type": "text", "required": false}]}</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="Record_Finalize_Report" name="보고본 확정 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{"app_id": "nowview-sc06", "operation": "finalize_report", "input": {"demo_run_id": "데모실행ID", "node_id": "'Finalize_Report'", "decision": "확정결정", "content": "확정내용", "note": "남는사항", "answered_by": "확정자", "answered_via": "확정경로"}, "output": {"보고상태": "state", "error_message": "error_message"}}</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="Report_CEO" name="대표 월간 보고">
      <bpmn:extensionElements>
        <chk:approval>{"title": "U602 대표 월간 보고 — 개선 기여·남는 차이·보완·발의·다음 확인", "answered_by_as": "보고받은이", "answered_via_as": "보고경로", "assignees": ["임하준"], "description": "대표가 확정본을 보고받았음을 남긴다. 보고는 PROP61 실행 승인·예산 승인이 아니다 — 발의의 효과·예산은 미산정이다.", "show": ["보고버전", "보고상태", "error_message"], "fields": [{"key": "보고내용", "label": "보고 내용", "type": "text", "required": true}, {"key": "대표지시", "label": "대표 지시(없으면 비움)", "type": "text", "required": false}]}</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="Record_Report_CEO" name="대표 보고 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{"app_id": "nowview-sc06", "operation": "report_ceo", "input": {"demo_run_id": "데모실행ID", "node_id": "'Report_CEO'", "content": "보고내용", "directive": "대표지시", "answered_by": "보고받은이", "answered_via": "보고경로"}, "output": {"보고상태": "state", "error_message": "error_message"}}</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Confirm_Merge" name="담당 임원 확인(처음·재확인)"/>
    <bpmn:parallelGateway id="Gw_Confirm_Split" name="생산 ∥ 구매 임원 확인"/>
    <bpmn:parallelGateway id="Gw_Confirm_Join" name="담당 임원 확인 모으기"/>
    <bpmn:exclusiveGateway id="Gw_Review_Finance" name="종합 확인 결과" default="Flow_reviewed"/>
    <bpmn:exclusiveGateway id="Gw_Finalize" name="확정 결과" default="Flow_finalized"/>
    <bpmn:endEvent id="End" name="대표 보고 완료(RPT61-v1 REPORTED) — RISK61 OPEN"/>
    <bpmn:boundaryEvent id="Bnd_Record_Confirm_Prod" name="기록 거절" attachedToRef="Record_Confirm_Prod">
      <bpmn:errorEventDefinition errorRef="Err_record"/>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Bnd_Record_Confirm_Buy" name="기록 거절" attachedToRef="Record_Confirm_Buy">
      <bpmn:errorEventDefinition errorRef="Err_record"/>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Bnd_Record_Review_Finance" name="기록 거절" attachedToRef="Record_Review_Finance">
      <bpmn:errorEventDefinition errorRef="Err_record"/>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Bnd_Record_Draft_Conclusion" name="기록 거절" attachedToRef="Record_Draft_Conclusion">
      <bpmn:errorEventDefinition errorRef="Err_record"/>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Bnd_Record_Finalize_Report" name="기록 거절" attachedToRef="Record_Finalize_Report">
      <bpmn:errorEventDefinition errorRef="Err_record"/>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Bnd_Record_Report_CEO" name="기록 거절" attachedToRef="Record_Report_CEO">
      <bpmn:errorEventDefinition errorRef="Err_record"/>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_start" sourceRef="Start" targetRef="Task_Open"/>
    <bpmn:sequenceFlow id="Flow_open" sourceRef="Task_Open" targetRef="Gw_Confirm_Merge"/>
    <bpmn:sequenceFlow id="Flow_confirm_merged" sourceRef="Gw_Confirm_Merge" targetRef="Gw_Confirm_Split"/>
    <bpmn:sequenceFlow id="Flow_split_prod" sourceRef="Gw_Confirm_Split" targetRef="Confirm_Prod"/>
    <bpmn:sequenceFlow id="Flow_split_buy" sourceRef="Gw_Confirm_Split" targetRef="Confirm_Buy"/>
    <bpmn:sequenceFlow id="Flow_Confirm_Prod_answered" sourceRef="Confirm_Prod" targetRef="Record_Confirm_Prod"/>
    <bpmn:sequenceFlow id="Flow_Confirm_Buy_answered" sourceRef="Confirm_Buy" targetRef="Record_Confirm_Buy"/>
    <bpmn:sequenceFlow id="Flow_prod_recorded" sourceRef="Record_Confirm_Prod" targetRef="Gw_Confirm_Join"/>
    <bpmn:sequenceFlow id="Flow_buy_recorded" sourceRef="Record_Confirm_Buy" targetRef="Gw_Confirm_Join"/>
    <bpmn:sequenceFlow id="Flow_confirmed" sourceRef="Gw_Confirm_Join" targetRef="Review_Finance"/>
    <bpmn:sequenceFlow id="Flow_Review_Finance_answered" sourceRef="Review_Finance" targetRef="Record_Review_Finance"/>
    <bpmn:sequenceFlow id="Flow_review_recorded" sourceRef="Record_Review_Finance" targetRef="Gw_Review_Finance"/>
    <bpmn:sequenceFlow id="Flow_reconfirm" name="재확인 요청 — 담당 임원 확인을 다시" sourceRef="Gw_Review_Finance" targetRef="Gw_Confirm_Merge">
      <bpmn:conditionExpression>종합결정 == '재확인요청'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_reviewed" name="확인" sourceRef="Gw_Review_Finance" targetRef="Draft_Conclusion"/>
    <bpmn:sequenceFlow id="Flow_Draft_Conclusion_answered" sourceRef="Draft_Conclusion" targetRef="Record_Draft_Conclusion"/>
    <bpmn:sequenceFlow id="Flow_conclusion_recorded" sourceRef="Record_Draft_Conclusion" targetRef="Finalize_Report"/>
    <bpmn:sequenceFlow id="Flow_Finalize_Report_answered" sourceRef="Finalize_Report" targetRef="Record_Finalize_Report"/>
    <bpmn:sequenceFlow id="Flow_finalize_recorded" sourceRef="Record_Finalize_Report" targetRef="Gw_Finalize"/>
    <bpmn:sequenceFlow id="Flow_rework" name="보완 요청 — 결론을 다시" sourceRef="Gw_Finalize" targetRef="Draft_Conclusion">
      <bpmn:conditionExpression>확정결정 == '보완요청'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_finalized" name="확정" sourceRef="Gw_Finalize" targetRef="Report_CEO"/>
    <bpmn:sequenceFlow id="Flow_Report_CEO_answered" sourceRef="Report_CEO" targetRef="Record_Report_CEO"/>
    <bpmn:sequenceFlow id="Flow_reported" sourceRef="Record_Report_CEO" targetRef="End"/>
    <bpmn:sequenceFlow id="Flow_Record_Confirm_Prod_rejected" name="기록 거절 — 다시 답한다" sourceRef="Bnd_Record_Confirm_Prod" targetRef="Confirm_Prod"/>
    <bpmn:sequenceFlow id="Flow_Record_Confirm_Buy_rejected" name="기록 거절 — 다시 답한다" sourceRef="Bnd_Record_Confirm_Buy" targetRef="Confirm_Buy"/>
    <bpmn:sequenceFlow id="Flow_Record_Review_Finance_rejected" name="기록 거절 — 다시 답한다" sourceRef="Bnd_Record_Review_Finance" targetRef="Review_Finance"/>
    <bpmn:sequenceFlow id="Flow_Record_Draft_Conclusion_rejected" name="기록 거절 — 다시 답한다" sourceRef="Bnd_Record_Draft_Conclusion" targetRef="Draft_Conclusion"/>
    <bpmn:sequenceFlow id="Flow_Record_Finalize_Report_rejected" name="기록 거절 — 다시 답한다" sourceRef="Bnd_Record_Finalize_Report" targetRef="Finalize_Report"/>
    <bpmn:sequenceFlow id="Flow_Record_Report_CEO_rejected" name="기록 거절 — 다시 답한다" sourceRef="Bnd_Record_Report_CEO" targetRef="Report_CEO"/>
  </bpmn:process>
</bpmn:definitions>
