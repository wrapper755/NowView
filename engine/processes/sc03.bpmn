<?xml version="1.0" encoding="UTF-8"?>
<!--
  SC03 — 수익성 변동의 통합 분석과 수시 경영검토(장면 3). 업무 흐름의 유일한 원천이다(장면 1·2와 같다).

  BPM이 쥐는 것: 순서 · 사람 대기(분석·부서 확인·쟁점 판단·자료 확정·보고·결론·회의록·배정·인수·종료) · 분기
  (정합 실패 · 이견 · 차단 · 보완 후 재검토 · 반려) · 장면 4 인계. 쥐지 않는 것: 손익·부족·정합 계산 — 서비스 태스크가
  NowView 계산 서비스(`nowview-sc03`)를 부른다. 엔진은 숫자를 모른다(P39).

  단계 대응(업무설계표 S31~S44): 착수(S31, 화면 명령 — 이 그림은 착수된 검토건을 연다) → S32·S33 분석 → S34~S36 부서 확인
  (병렬) → S37 쟁점 → S38 자료 확정·배포 → S39 보고 → S40·S41 결론·후보 → S42 회의록 → S41 배정 → S43 인수 → S44 종료.
  회의 질의·답변·후보 설명(QA31~)과 Agent 회의 요약(AG31)은 BPM 밖의 회의 기록이다.

  **Studio 시험 실행·Center 서버 실행에서 돈다**(장면 1·2 N1~N6과 같은 틀). 서비스 태스크는 외부 확장 `nowview-sc03`
  (`chaeksas/nowview-sc03.extension.json`)의 HTTP 작업이고 본문마다 `{{run_id}}`로 데모 실행을 묶는다. 결재에 답한 사람은
  `answered_by_as`·`answered_via_as`로 받아 기록 작업에 싣는다. 기록이 거절되면 오류 경계로 **같은 결재로 되돌아간다**.
  병렬 갈래끼리 변수가 겹치지 않게 폼 칸 이름에 부서·과제를 붙였다(영업회신·AT31결정 …).
  역할은 `app/sc03/domain.py`의 NODE_ROLES, 결재 담당자 이름은 `chk:approval.assignees` — 시험이 맞춰 본다.
  이 파일은 손으로 고쳐도 된다 — 생성기는 남기지 않았다.
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:chk="urn:chaeksas:bpmn:1" id="Defs_sc03">
  <bpmn:error id="Err_record" name="기록 거절" errorCode="TASK_FAILED"/>
  <bpmn:process id="autopart1.sc03" name="SC03 통합 손익영향 검토와 대응안 분석 지시" isExecutable="true">
    <bpmn:extensionElements>
      <chk:process>{"run_location": "server", "extensions": [{"id": "nowview-sc03", "version": "&gt;=0.1.0,&lt;1"}], "inputs": [{"name": "데모실행ID", "type": "string", "required": true}]}</chk:process>
    </bpmn:extensionElements>
    <bpmn:startEvent id="Start" name="검토 착수"/>
    <bpmn:serviceTask id="Task_Open" name="검토건 열기">
      <bpmn:extensionElements>
        <chk:serviceCall>{"app_id": "nowview-sc03", "operation": "open_review", "input": {"demo_run_id": "데모실행ID"}, "output": {"검토ID": "review_id", "담당자명": "assignee_name"}}</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <!-- S32·S33 CT31~CT33 공통 기준 확인 · 통합 계산 — 승인 단가만 반영, 정합 검증이 계산의 일부다 -->
    <bpmn:userTask id="Save_Analysis" name="통합 분석 실행·저장">
      <bpmn:extensionElements>
        <chk:approval>{"title": "통합 손익영향 분석 — 기준 확인", "answered_by_as": "분석자", "answered_via_as": "분석경로", "assignees": ["정하윤"], "description": "F02+EXT28-v1 · C02-APP01 · FC01/FC28-v1 · PV-APP01 기준을 확인하고 통합 분석을 저장한다. 요청·협상안은 합산하지 않는다.", "show": ["검토ID", "error_message"], "fields": [{"key": "기준확인", "label": "분석 기준(물량·원가·고정비·승인단가) 확인", "type": "choice", "required": true, "choices": ["확인"]}, {"key": "분석메모", "label": "메모", "type": "text"}]}</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="Record_Analysis" name="통합 분석 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{"app_id": "nowview-sc03", "operation": "run_analysis", "input": {"demo_run_id": "데모실행ID", "node_id": "'Save_Analysis'", "basis": "기준확인", "memo": "분석메모", "answered_by": "분석자", "answered_via": "분석경로"}, "output": {"분석ID": "run_id", "정합": "passed", "error_message": "error_message"}}</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Calc" name="계산 정합" default="Flow_calc_blocked"/>
    <bpmn:userTask id="Fix_Calc" name="계산 오류 정정">
      <bpmn:extensionElements>
        <chk:approval>{"title": "정합 실패 — 계산 입력 정정", "answered_by_as": "정정자", "answered_via_as": "정정경로", "assignees": ["정하윤"], "description": "정합 검증이 실패했다(CT33). 보고·확인 요청이 막힌다. 입력을 바로잡고 다시 계산한다 — 조건부 수용으로 우회할 수 없다.", "show": ["분석ID", "error_message"], "fields": [{"key": "정정내용", "label": "정정 내용", "type": "text", "required": true}]}</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="Record_Fix" name="정정·재계산 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{"app_id": "nowview-sc03", "operation": "fix_calc", "input": {"demo_run_id": "데모실행ID", "node_id": "'Fix_Calc'", "note": "정정내용", "answered_by": "정정자", "answered_via": "정정경로"}, "output": {"분석ID": "run_id", "정합": "passed", "error_message": "error_message"}}</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Agent_Impact" name="Agent 손익 설명 초안">
      <bpmn:extensionElements>
        <chk:serviceCall>{"app_id": "nowview-sc03", "operation": "agent_draft", "input": {"demo_run_id": "데모실행ID", "kind": "'AG30'"}, "output": {"손익설명초안ID": "output_id"}}</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <!-- S34~S36 CT34 부서 확인 요청 → 영업 ∥ 구매 ∥ 생산. 무응답은 동의가 아니다. 이견이면 초안 보완 → 그 부서 재확인 -->
    <bpmn:userTask id="Request_Confirm" name="부서 확인 요청">
      <bpmn:extensionElements>
        <chk:approval>{"title": "통합 분석 초안 — 부서 확인 요청", "answered_by_as": "요청자", "answered_via_as": "요청경로", "assignees": ["정하윤"], "description": "정합한 초안을 영업·구매·생산에 보낸다. 회신기한은 6/28 18시가 기본이다.", "show": ["분석ID", "error_message"], "fields": [{"key": "회신기한", "label": "회신기한 (KST, 예 2027-06-28T18:00:00+09:00)", "type": "text", "required": true}, {"key": "요청메모", "label": "요청 메모", "type": "text"}]}</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="Record_Request" name="확인 요청 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{"app_id": "nowview-sc03", "operation": "request_confirmation", "input": {"demo_run_id": "데모실행ID", "node_id": "'Request_Confirm'", "due": "회신기한", "memo": "요청메모", "answered_by": "요청자", "answered_via": "요청경로"}, "output": {"보고초안ID": "report_id", "error_message": "error_message"}}</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gw_Confirm_Split" name="영업 ∥ 구매 ∥ 생산"/>
    <bpmn:parallelGateway id="Gw_Confirm_Join" name="부서 회신 모으기"/>
    <bpmn:userTask id="Confirm_Sales" name="영업 사실 확인">
      <bpmn:extensionElements>
        <chk:approval>{"title": "영업 확인 — 사실·가정·미확인", "answered_by_as": "영업확인자", "answered_via_as": "영업확인경로", "assignees": ["박서진"], "description": "영업 범위의 사실과 내부가정, 자료가 없는 미확인을 나눠 적는다. 이견이면 의견·보완 요청을 남긴다(원 의견은 보존된다).", "show": ["보고초안ID", "분석ID", "error_message"], "fields": [{"key": "영업회신", "label": "회신", "type": "choice", "required": true, "choices": ["확인", "이견"]}, {"key": "영업사실", "label": "확인한 사실 (이견이면 이견 내용)", "type": "text", "required": true}, {"key": "영업가정", "label": "내부가정 (있으면)", "type": "text"}, {"key": "영업미확인", "label": "미확인 사항 (있으면)", "type": "text"}, {"key": "영업질문", "label": "미확인에 붙일 확인 질문", "type": "text"}, {"key": "영업근거", "label": "근거", "type": "text", "required": true}, {"key": "영업의견", "label": "의견·보완 요청", "type": "text"}]}</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="Record_Confirm_Sales" name="영업 확인 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{"app_id": "nowview-sc03", "operation": "record_confirmation", "input": {"demo_run_id": "데모실행ID", "node_id": "'Confirm_Sales'", "dept": "'SALES'", "reply": "영업회신", "fact": "영업사실", "assumption": "영업가정", "unconfirmed": "영업미확인", "question": "영업질문", "evidence": "영업근거", "opinion": "영업의견", "answered_by": "영업확인자", "answered_via": "영업확인경로"}, "output": {"error_message": "error_message"}}</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Confirm_Sales" name="영업 회신" default="Flow_sales_ok"/>
    <bpmn:userTask id="Revise_Sales" name="영업 이견 보완">
      <bpmn:extensionElements>
        <chk:approval>{"title": "영업 이견 — 초안 보완", "answered_by_as": "영업보완자", "answered_via_as": "영업보완경로", "assignees": ["정하윤"], "description": "이견을 반영해 초안을 새 버전으로 고친다. 승인 원천은 바꾸지 않는다 — 그 부서가 다시 확인한다.", "show": ["보고초안ID", "error_message"], "fields": [{"key": "영업보완내용", "label": "보완 내용(변경 요약)", "type": "text", "required": true}]}</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="Record_Revise_Sales" name="영업 보완 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{"app_id": "nowview-sc03", "operation": "record_revision", "input": {"demo_run_id": "데모실행ID", "node_id": "'Revise_Sales'", "change": "영업보완내용", "answered_by": "영업보완자", "answered_via": "영업보완경로"}, "output": {"보고초안ID": "report_id", "error_message": "error_message"}}</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="Confirm_Buy" name="구매 사실 확인">
      <bpmn:extensionElements>
        <chk:approval>{"title": "구매 확인 — 사실·가정·미확인", "answered_by_as": "구매확인자", "answered_via_as": "구매확인경로", "assignees": ["서도현"], "description": "구매 범위의 사실과 내부가정, 자료가 없는 미확인을 나눠 적는다. 이견이면 의견·보완 요청을 남긴다(원 의견은 보존된다).", "show": ["보고초안ID", "분석ID", "error_message"], "fields": [{"key": "구매회신", "label": "회신", "type": "choice", "required": true, "choices": ["확인", "이견"]}, {"key": "구매사실", "label": "확인한 사실 (이견이면 이견 내용)", "type": "text", "required": true}, {"key": "구매가정", "label": "내부가정 (있으면)", "type": "text"}, {"key": "구매미확인", "label": "미확인 사항 (있으면)", "type": "text"}, {"key": "구매질문", "label": "미확인에 붙일 확인 질문", "type": "text"}, {"key": "구매근거", "label": "근거", "type": "text", "required": true}, {"key": "구매의견", "label": "의견·보완 요청", "type": "text"}]}</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="Record_Confirm_Buy" name="구매 확인 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{"app_id": "nowview-sc03", "operation": "record_confirmation", "input": {"demo_run_id": "데모실행ID", "node_id": "'Confirm_Buy'", "dept": "'BUY'", "reply": "구매회신", "fact": "구매사실", "assumption": "구매가정", "unconfirmed": "구매미확인", "question": "구매질문", "evidence": "구매근거", "opinion": "구매의견", "answered_by": "구매확인자", "answered_via": "구매확인경로"}, "output": {"error_message": "error_message"}}</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Confirm_Buy" name="구매 회신" default="Flow_buy_ok"/>
    <bpmn:userTask id="Revise_Buy" name="구매 이견 보완">
      <bpmn:extensionElements>
        <chk:approval>{"title": "구매 이견 — 초안 보완", "answered_by_as": "구매보완자", "answered_via_as": "구매보완경로", "assignees": ["정하윤"], "description": "이견을 반영해 초안을 새 버전으로 고친다. 승인 원천은 바꾸지 않는다 — 그 부서가 다시 확인한다.", "show": ["보고초안ID", "error_message"], "fields": [{"key": "구매보완내용", "label": "보완 내용(변경 요약)", "type": "text", "required": true}]}</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="Record_Revise_Buy" name="구매 보완 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{"app_id": "nowview-sc03", "operation": "record_revision", "input": {"demo_run_id": "데모실행ID", "node_id": "'Revise_Buy'", "change": "구매보완내용", "answered_by": "구매보완자", "answered_via": "구매보완경로"}, "output": {"보고초안ID": "report_id", "error_message": "error_message"}}</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="Confirm_Prod" name="생산 사실 확인">
      <bpmn:extensionElements>
        <chk:approval>{"title": "생산 확인 — 사실·가정·미확인", "answered_by_as": "생산확인자", "answered_via_as": "생산확인경로", "assignees": ["배정훈"], "description": "생산 범위의 사실과 내부가정, 자료가 없는 미확인을 나눠 적는다. 이견이면 의견·보완 요청을 남긴다(원 의견은 보존된다).", "show": ["보고초안ID", "분석ID", "error_message"], "fields": [{"key": "생산회신", "label": "회신", "type": "choice", "required": true, "choices": ["확인", "이견"]}, {"key": "생산사실", "label": "확인한 사실 (이견이면 이견 내용)", "type": "text", "required": true}, {"key": "생산가정", "label": "내부가정 (있으면)", "type": "text"}, {"key": "생산미확인", "label": "미확인 사항 (있으면)", "type": "text"}, {"key": "생산질문", "label": "미확인에 붙일 확인 질문", "type": "text"}, {"key": "생산근거", "label": "근거", "type": "text", "required": true}, {"key": "생산의견", "label": "의견·보완 요청", "type": "text"}]}</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="Record_Confirm_Prod" name="생산 확인 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{"app_id": "nowview-sc03", "operation": "record_confirmation", "input": {"demo_run_id": "데모실행ID", "node_id": "'Confirm_Prod'", "dept": "'PROD'", "reply": "생산회신", "fact": "생산사실", "assumption": "생산가정", "unconfirmed": "생산미확인", "question": "생산질문", "evidence": "생산근거", "opinion": "생산의견", "answered_by": "생산확인자", "answered_via": "생산확인경로"}, "output": {"error_message": "error_message"}}</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Confirm_Prod" name="생산 회신" default="Flow_prod_ok"/>
    <bpmn:userTask id="Revise_Prod" name="생산 이견 보완">
      <bpmn:extensionElements>
