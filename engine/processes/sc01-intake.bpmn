<?xml version="1.0" encoding="UTF-8"?>
<!--
  SC01 고객계획 접수 Bot — 「고객계획 접수 담당」 가상 직원의 접수 Bot(docs/chaeksas-integration.md N5).

  기획안 1단계(데이터 수집·이상 징후 감지는 Agent, 승인은 사람)를 Chaeksas 가상 직원으로 옮긴 것이다.
  NowView가 원천을 받으면 Center 메시지(`고객계획접수`, 본문의 `virtual_worker`로 가상 직원을 고른다)가
  이 Bot을 깨운다 → 원천마다 자동 검증 → 감독자 일괄 결재 → 승인이면 원천마다 SC01을 위임해 기동한다
  (Call Activity 반복 + 위임, ADR-0082). **반려면 SC01을 시작하지 않는다** — 기록 작업이 원천을
  NEEDS_INFO로 두고 영업담당에게 보완 요청 업무를 연다.

  * **감독자 이름을 그림에 적지 않는다.** 일괄 결재의 담당자는 입력 `감독자`이고, 그 값은 Center가
    가상 직원 등록(CON-13 `supervisors`)에서 넣는다(값 출처 `virtual_worker.supervisors`, ADR-0099).
    필수라서 가상 직원 없이 돌리면 시작하지 않는다(`input_required`). 부르는 쪽(NowView)이 이 입력을
    보내면 422 `input_not_from_caller`다.
  * **일괄 결재는 건별이 아니라 일괄로 승인·반려한다.** 결재 폼에 여러 건을 고르는 칸이 없고(C14 —
    bool·number·text·choice), 결재 뒤에 반복할 목록을 다시 만들면 B16 「보여 준 것과 다른 것을 기동」이
    되어 Center가 이 Bot을 가상 직원에 묶지 않는다(`intake_not_gated`). NowView는 수신 한 번에 메시지
    하나를 보내므로 일괄 하나가 대개 원천 하나다.
  * 위임은 **함께 돈다**(`isSequential=false`, ADR-0087) — SC01은 사람을 며칠 기다린다. 차례로 돌면
    둘째 건이 첫째 건의 인계까지 기동되지 않는다.
  * 이 그림의 작업은 데모 실행을 바깥 실행에 **묶지 않는다** — 묶는 것은 위임된 SC01의 첫 호출이다(N2).
  * Studio는 위임하지 않는다(B14) — 이 그림은 Center 서버 Bot으로만 돈다.
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:chk="urn:chaeksas:bpmn:1" id="Defs_sc01_intake">
  <bpmn:message id="Msg_intake" name="고객계획접수"/>
  <bpmn:error id="Err_delegation" name="기동 실패" errorCode="DELEGATION_FAILED"/>
  <bpmn:process id="autoparts.sc01-intake" name="SC01 고객계획 접수" isExecutable="true">
    <bpmn:extensionElements>
      <chk:process>{
        "run_location": "server",
        "extensions": [{"id": "nowview", "version": "&gt;=0.1.0,&lt;1"}],
        "inputs": [
          {"name": "원천목록", "type": "list", "required": true,
           "description": "{데모실행ID, 원천ID} 목록 — NowView 원천 수신이 메시지 본문에 싣는다"},
          {"name": "감독자", "type": "list", "required": true, "source": "virtual_worker.supervisors",
           "description": "일괄을 승인할 사람들 — Center가 가상 직원 등록에서 넣는다"},
          {"name": "가상직원", "type": "string", "source": "virtual_worker.name",
           "description": "이 일괄을 낸 가상 직원의 이름 — NowView 기록에 처리자로 남는다"}
        ]
      }</chk:process>
    </bpmn:extensionElements>

    <bpmn:startEvent id="Start" name="고객계획 접수">
      <bpmn:messageEventDefinition messageRef="Msg_intake"/>
    </bpmn:startEvent>

    <bpmn:scriptTask id="Task_Count" name="건수 세기" scriptFormat="chk-expr">
      <bpmn:script>건수 = len(원천목록)</bpmn:script>
    </bpmn:scriptTask>

    <!-- 원천마다 자동 검증 — SC01의 S01·S02와 같은 검사다. 결과는 결재가 보인다(검증 오류가 있어도 결재로 간다) -->
    <bpmn:serviceTask id="Task_Screen" name="원천 자동 검증 (건마다)">
      <bpmn:extensionElements>
        <chk:serviceCall>{
          "app_id": "nowview", "operation": "screen_customer_plan",
          "input": {"demo_run_id": "건['데모실행ID']", "source_id": "건['원천ID']", "processed_by": "가상직원"},
          "output": {"검토": "summary"}
        }</chk:serviceCall>
        <chk:loop>{"collection": "원천목록", "item": "건", "result": "검토", "collect_into": "검토목록"}</chk:loop>
      </bpmn:extensionElements>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true"/>
    </bpmn:serviceTask>

    <!-- 감독자 일괄 결재 — 담당자는 가상 직원의 감독자다(이름을 그림에 적지 않는다) -->
    <bpmn:userTask id="Approve_Batch" name="접수 일괄 승인">
      <bpmn:extensionElements>
        <chk:approval>{
          "title": "고객계획 {건수}건 접수 — SC01 기동",
          "description": "검증 결과와 변경 요약을 보고 SC01(공급전망 갱신)을 기동할지 정한다. 반려하면 원천은 보완 요청으로 돌아간다.",
          "show": ["원천목록", "검토목록", "건수"],
          "fields": [
            {"key": "결정", "label": "결정", "type": "choice", "required": true, "choices": ["승인", "반려"]},
            {"key": "의견", "label": "의견", "type": "text", "required": true}
          ],
          "location": "center",
          "assignees": "감독자",
          "answered_by_as": "승인자", "answered_via_as": "승인경로"
        }</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>

    <!-- 결정 기록 — 반려면 원천 NEEDS_INFO + 보완 요청 업무(TASK-DQ), 승인이면 감사 이력만 -->
    <bpmn:serviceTask id="Record_Batch" name="접수 결정 기록 (건마다)">
      <bpmn:extensionElements>
        <chk:serviceCall>{
          "app_id": "nowview", "operation": "record_intake_decision",
          "input": {"demo_run_id": "건['데모실행ID']", "source_id": "건['원천ID']", "decision": "결정", "opinion": "의견", "answered_by": "승인자", "answered_via": "승인경로", "processed_by": "가상직원"},
          "output": {"기록": "recorded"}
        }</chk:serviceCall>
        <chk:loop>{"collection": "원천목록", "item": "건", "result": "기록", "collect_into": "기록목록"}</chk:loop>
      </bpmn:extensionElements>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true"/>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gw_Decision" name="승인?" default="Flow_rejected"/>

    <!-- 승인된 건마다 SC01 위임 — 처리자(가상 직원 이름)는 넘기지 않는다: SC01이 출처로 선언했다 -->
    <bpmn:callActivity id="Call_SC01" name="SC01 기동 (건마다 위임)" calledElement="autoparts.sc01">
      <bpmn:extensionElements>
        <chk:call>{
          "delegate": {"bpm_process_id": "autoparts.sc01"},
          "input": {"데모실행ID": "건['데모실행ID']", "원천ID": "건['원천ID']"},
          "output": {}
        }</chk:call>
        <chk:loop>{"collection": "원천목록", "item": "건", "collect_into": "기동목록"}</chk:loop>
      </bpmn:extensionElements>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false"/>
    </bpmn:callActivity>
    <bpmn:boundaryEvent id="Bnd_Call" name="기동 실패" attachedToRef="Call_SC01">
      <bpmn:errorEventDefinition errorRef="Err_delegation"/>
    </bpmn:boundaryEvent>

    <bpmn:scriptTask id="Task_Failed" name="기동 실패 사유" scriptFormat="chk-expr">
      <bpmn:script>실패사유 = error_message</bpmn:script>
    </bpmn:scriptTask>

    <bpmn:endEvent id="End_Started" name="SC01 끝"/>
    <bpmn:endEvent id="End_Rejected" name="반려 — 보완 요청"/>
    <bpmn:endEvent id="End_Failed" name="기동 실패"/>

    <bpmn:sequenceFlow id="Flow_start" sourceRef="Start" targetRef="Task_Count"/>
    <bpmn:sequenceFlow id="Flow_counted" sourceRef="Task_Count" targetRef="Task_Screen"/>
    <bpmn:sequenceFlow id="Flow_screened" sourceRef="Task_Screen" targetRef="Approve_Batch"/>
    <bpmn:sequenceFlow id="Flow_decided" sourceRef="Approve_Batch" targetRef="Record_Batch"/>
    <bpmn:sequenceFlow id="Flow_recorded" sourceRef="Record_Batch" targetRef="Gw_Decision"/>
    <bpmn:sequenceFlow id="Flow_approved" name="승인" sourceRef="Gw_Decision" targetRef="Call_SC01">
      <bpmn:conditionExpression>결정 == '승인'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_rejected" name="반려" sourceRef="Gw_Decision" targetRef="End_Rejected"/>
    <bpmn:sequenceFlow id="Flow_started" sourceRef="Call_SC01" targetRef="End_Started"/>
    <bpmn:sequenceFlow id="Flow_call_failed" sourceRef="Bnd_Call" targetRef="Task_Failed"/>
    <bpmn:sequenceFlow id="Flow_failed" sourceRef="Task_Failed" targetRef="End_Failed"/>
  </bpmn:process>
</bpmn:definitions>
