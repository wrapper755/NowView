<?xml version="1.0" encoding="UTF-8"?>
<!--
  SC01 — 고객 생산계획 변경에 따른 공급전망 갱신과 목표 미달 위험 대응.

  업무 흐름의 유일한 원천이다. Chaeksas 엔진이 이 파일을 그대로 해석하고, Chaeksas Studio
  (bpmn-js)로 열어 고칠 수 있다. 다이어그램(DI)은 없다 — Studio에서 열면 자동 배치된다.

  BPM이 쥐는 것: 순서 · 사람 대기(배정·인수·검토) · 분기 · 인계.
  BPM이 쥐지 않는 것: 계산 · 원천 검증 · 이슈 갱신 — 서비스 태스크가 NowView 계산 서비스
  (`nowview.sc01`)를 부른다. 엔진은 숫자를 모른다(구현명세 AG-01, 설계 G12).

  단계 대응(SC01 설계서 1.5): S01 접수 → S02 원천 확인(CT01) → S03·S04 전망 작성·비교 계산 →
  S05 영업 검토(CT02) → S06 현업 배정(CT03) ∥ S07 경영 검토 연결 → S08 인계.
  역할 검사는 `app/sc01/domain.py`의 NODE_ROLES가 하고, 바깥 Chaeksas가 쓸 결재 담당자는
  `chk:approval.assignees`(사람 이름)에 있다 — 둘은 테스트가 맞춰 본다.
  사람 결정의 업무 효과는 결재 뒤의 「… 기록」 서비스 태스크가 낸다(docs/chaeksas-integration.md N1).
  답한 사람은 결재마다 `answered_by_as`·`answered_via_as` 변수로 받아 기록 작업에 싣는다(R1, ADR-0096) —
  어디서 답했든(내장·Studio·Center 콘솔·NowView 대리 답) 짐작하지 않는다.
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:chk="urn:chaeksas:bpmn:1" id="Defs_sc01">
  <bpmn:message id="Msg_correction" name="원천정정"/>
  <bpmn:error id="Err_record" name="기록 거절" errorCode="TASK_FAILED"/>
  <bpmn:process id="nowview.sc01" name="SC01 고객계획 변경 대응" isExecutable="true">
    <bpmn:extensionElements>
      <chk:process>{
        "run_location": "server",
        "service_keys": {"nowview-sc01": "nowview"},
        "inputs": [
          {"name": "데모실행ID", "type": "string", "required": true},
          {"name": "원천ID", "type": "string", "required": true}
        ]
      }</chk:process>
    </bpmn:extensionElements>

    <bpmn:startEvent id="Start" name="고객계획 수신"/>

    <!-- S01·S02 원천 자동 검증 — 필수값·매핑·정수·중복·완전성·물량 범위(UI03-01) -->
    <bpmn:serviceTask id="Task_Validate" name="원천 자동 검증">
      <bpmn:extensionElements>
        <chk:serviceCall>{
          "app_id": "nowview-sc01", "operation": "validate_source",
          "input": {"demo_run_id": "데모실행ID", "source_id": "원천ID"},
          "output": {"검증통과": "passed", "검증오류수": "error_count"}
        }</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <!-- S02 CT01 자료 적합성 확인 — 영업담당 (TASK-DQ) -->
    <bpmn:userTask id="Approve_DQ" name="원천 확인">
      <bpmn:extensionElements>
        <chk:approval>{
          "title": "고객계획 원천 확인",
          "answered_by_as": "확인자", "answered_via_as": "확인경로",
          "assignees": ["이도윤"],
          "description": "고객·모델·공장·대상 월, 월 전체/잔여, 당사 배정 여부를 확인한다. 40%를 다시 곱하지 않는다.",
          "show": ["원천ID", "검증통과", "검증오류수", "error_message"],
          "fields": [
            {"key": "확인결과", "label": "확인 결과", "type": "choice", "required": true,
             "choices": ["확인완료", "보완요청"]},
            {"key": "확인의견", "label": "확인 의견", "type": "text", "required": true},
            {"key": "확인근거", "label": "근거", "type": "text", "required": true}
          ]
        }</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>

    <!-- 결정 기록 — 결재를 어디서 답했든(내장·Studio·Center) 원천 확인·업무 완료가 이 길로 난다(N1) -->
    <bpmn:serviceTask id="Record_DQ" name="원천 확인 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{
          "app_id": "nowview-sc01", "operation": "record_dq_review",
          "input": {"demo_run_id": "데모실행ID", "node_id": "'Approve_DQ'", "source_id": "원천ID", "result": "확인결과", "opinion": "확인의견", "evidence": "확인근거", "answered_by": "확인자", "answered_via": "확인경로"},
          "output": {"error_message": "error_message"}
        }</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Bnd_Record_DQ" name="기록 거절" attachedToRef="Record_DQ">
      <bpmn:errorEventDefinition errorRef="Err_record"/>
    </bpmn:boundaryEvent>

    <bpmn:exclusiveGateway id="Gw_DQ" name="원천 확인 결과" default="Flow_dq_fix"/>

    <!-- 보완 — 정정본이 오면 새 원천ID로 다시 검증한다. 이전 원천은 지우지 않는다(1.10).
         상관 키는 데모실행ID — Center는 상관 키 없는 메시지로 기다리는 실행을 찾지 않는다(C12, N3). -->
    <bpmn:receiveTask id="Wait_Correction" name="정정본 대기" messageRef="Msg_correction">
      <bpmn:extensionElements>
        <chk:receive>{"message": "원천정정", "correlation": "데모실행ID", "payload": ["원천ID"]}</chk:receive>
      </bpmn:extensionElements>
    </bpmn:receiveTask>

    <!-- S03·S04 비교 계산 실행 — 영업담당이 누른다(UI03 "비교 계산") -->
    <bpmn:userTask id="Confirm_Calc" name="비교 계산 실행">
      <bpmn:extensionElements>
        <chk:approval>{
          "title": "비교 계산 실행",
          "answered_by_as": "계산요청자", "answered_via_as": "계산요청경로",
          "assignees": ["이도윤"],
          "description": "T01 · 직전 승인 전망 F01 · 확인된 원천으로 최신 전망을 만들고 지표를 계산한다.",
          "show": ["원천ID"],
          "fields": [{"key": "계산메모", "label": "메모", "type": "text"}]
        }</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <!-- 결재다(확인 manualTask가 아니다) — 확인에는 담당자를 둘 수 없다(C14 B12). 메모 칸은 선택이다. -->

    <bpmn:serviceTask id="Task_Calc" name="전망 생성 · 지표 계산">
      <bpmn:extensionElements>
        <chk:serviceCall>{
          "app_id": "nowview-sc01", "operation": "compare",
          "input": {"demo_run_id": "데모실행ID", "source_id": "원천ID", "answered_by": "계산요청자", "answered_via": "계산요청경로"},
          "output": {"계산ID": "run_id", "위험수준": "risk", "이슈ID": "issue_id"}
        }</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <!--
      Agent 검토 지원 요청(AG-01). **기다리지 않는다** — 요청만 남기고 바로 영업 검토로 간다.
      초안은 배경에서 만들어지고 검증을 통과해야 화면에 나온다. Agent가 실패해도 검토는 계속된다(EX08).
      LLM을 이 노드 안에서 기다리면 프록시가 100초에 끊는다(CLAUDE.md 4.15).
    -->
    <bpmn:serviceTask id="Task_AgentRequest" name="Agent 검토 초안 요청">
      <bpmn:extensionElements>
        <chk:serviceCall>{
          "app_id": "nowview-sc01", "operation": "request_agent_draft",
          "input": {"demo_run_id": "데모실행ID", "run_id": "계산ID"},
          "output": {"초안ID": "output_id"}
        }</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <!-- S05 CT02 공급전망·Risk 검토 — 영업팀장 (TASK-SALES) -->
    <bpmn:userTask id="Approve_Sales" name="영업 검토">
      <bpmn:extensionElements>
        <chk:approval>{
          "title": "공급전망 변동 · 위험 검토",
          "answered_by_as": "영업검토자", "answered_via_as": "영업검토경로",
          "assignees": ["박서진"],
          "description": "변경의 의미·지속성·고객 재확인 필요성과 후속 처리 경로를 판단한다. 계산 경보는 바꾸지 않는다.",
          "show": ["계산ID", "위험수준", "이슈ID", "초안ID", "error_message"],
          "fields": [
            {"key": "영업의견", "label": "검토 의견", "type": "text", "required": true},
            {"key": "영업근거", "label": "근거", "type": "text", "required": true},
            {"key": "경영검토요청", "label": "경영 검토 추가 요청(중요 미만일 때)", "type": "bool",
             "default": false}
          ]
        }</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>

    <bpmn:serviceTask id="Record_Sales" name="영업 검토 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{
          "app_id": "nowview-sc01", "operation": "record_sales_review",
          "input": {"demo_run_id": "데모실행ID", "node_id": "'Approve_Sales'", "run_id": "계산ID", "opinion": "영업의견", "evidence": "영업근거", "manual_review": "경영검토요청", "agent_output": "초안ID", "answered_by": "영업검토자", "answered_via": "영업검토경로"},
          "output": {"error_message": "error_message"}
        }</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Bnd_Record_Sales" name="기록 거절" attachedToRef="Record_Sales">
      <bpmn:errorEventDefinition errorRef="Err_record"/>
    </bpmn:boundaryEvent>

    <!--
      현업 검토는 경보와 무관하게 항상 간다(S08·UI04-04). 경영 검토는 중요이거나 사유 있는 수동
      요청일 때 함께 간다(WF-05). 둘은 병행한다 — 경영 검토 중이라고 현업 대응을 멈추지 않는다(1.5).
    -->
    <bpmn:inclusiveGateway id="Gw_Route" name="후속 처리 경로"/>

    <!-- S06 CT03 현업 검토 배정 — 영업팀장 (EV04) -->
    <bpmn:userTask id="Approve_Dispatch" name="현업 검토 배정">
      <bpmn:extensionElements>
        <chk:approval>{
          "title": "생산·자재 영향 검토 배정",
          "answered_by_as": "배정자", "answered_via_as": "배정경로",
          "assignees": ["박서진"],
          "show": ["계산ID", "이슈ID", "error_message"],
          "fields": [
            {"key": "생산담당자", "label": "생산 담당", "type": "text", "required": true},
            {"key": "자재담당자", "label": "자재 담당", "type": "text", "required": true},
            {"key": "배정사유", "label": "검토 목적", "type": "text", "required": true}
          ]
        }</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>

    <!-- 인수 결재의 담당자는 이름이다 — 폼이 고른 id를 이름으로 바꿔 돌려받는다 -->
    <bpmn:serviceTask id="Record_Dispatch" name="현업 배정 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{
          "app_id": "nowview-sc01", "operation": "record_dispatch",
          "input": {"demo_run_id": "데모실행ID", "node_id": "'Approve_Dispatch'", "prod": "생산담당자", "mat": "자재담당자", "answered_by": "배정자", "answered_via": "배정경로"},
          "output": {"생산담당자명": "prod_name", "자재담당자명": "mat_name", "error_message": "error_message"}
        }</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Bnd_Record_Dispatch" name="기록 거절" attachedToRef="Record_Dispatch">
      <bpmn:errorEventDefinition errorRef="Err_record"/>
    </bpmn:boundaryEvent>

    <!-- 생산과 자재는 반드시 별도 업무다(UI05-01) -->
    <bpmn:parallelGateway id="Gw_Ops_Split" name="생산 ∥ 자재"/>

    <bpmn:userTask id="Accept_PROD" name="생산 영향 검토 인수">
      <bpmn:extensionElements>
        <chk:approval>{
          "title": "생산계획 영향 검토 인수",
          "answered_by_as": "생산인수자", "answered_via_as": "생산인수경로",
          "assignees": "생산담당자명",
          "show": ["계산ID", "이슈ID", "배정사유", "error_message"],
          "fields": [{"key": "생산인수의견", "label": "인수 의견", "type": "text"}]
        }</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>

    <bpmn:serviceTask id="Record_PROD" name="생산 인수 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{
          "app_id": "nowview-sc01", "operation": "record_acceptance",
          "input": {"demo_run_id": "데모실행ID", "node_id": "'Accept_PROD'", "run_id": "계산ID", "answered_by": "생산인수자", "answered_via": "생산인수경로"},
          "output": {"error_message": "error_message"}
        }</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Bnd_Record_PROD" name="기록 거절" attachedToRef="Record_PROD">
      <bpmn:errorEventDefinition errorRef="Err_record"/>
    </bpmn:boundaryEvent>

    <bpmn:userTask id="Accept_MAT" name="자재 영향 검토 인수">
      <bpmn:extensionElements>
        <chk:approval>{
          "title": "소요자재·발주 영향 검토 인수",
          "answered_by_as": "자재인수자", "answered_via_as": "자재인수경로",
          "assignees": "자재담당자명",
          "show": ["계산ID", "이슈ID", "배정사유", "error_message"],
          "fields": [{"key": "자재인수의견", "label": "인수 의견", "type": "text"}]
        }</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>

    <bpmn:serviceTask id="Record_MAT" name="자재 인수 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{
          "app_id": "nowview-sc01", "operation": "record_acceptance",
          "input": {"demo_run_id": "데모실행ID", "node_id": "'Accept_MAT'", "run_id": "계산ID", "answered_by": "자재인수자", "answered_via": "자재인수경로"},
          "output": {"error_message": "error_message"}
        }</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Bnd_Record_MAT" name="기록 거절" attachedToRef="Record_MAT">
      <bpmn:errorEventDefinition errorRef="Err_record"/>
    </bpmn:boundaryEvent>

    <bpmn:parallelGateway id="Gw_Ops_Join" name="현업 인수 모으기"/>

    <!-- S07 경영 검토 연결 — 영업팀장 (EV05) -->
    <bpmn:userTask id="Approve_Review" name="Management Review 요청">
      <bpmn:extensionElements>
        <chk:approval>{
          "title": "통합 손익 검토 요청",
          "answered_by_as": "검토요청자", "answered_via_as": "검토요청경로",
          "assignees": ["박서진"],
          "show": ["계산ID", "위험수준", "이슈ID", "error_message"],
          "fields": [
            {"key": "경영관리담당자", "label": "경영관리 담당", "type": "text", "required": true},
            {"key": "검토요청사유", "label": "요청 사유", "type": "text", "required": true}
          ]
        }</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>

    <bpmn:serviceTask id="Record_Review" name="경영 검토 요청 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{
          "app_id": "nowview-sc01", "operation": "record_review_request",
          "input": {"demo_run_id": "데모실행ID", "node_id": "'Approve_Review'", "fin": "경영관리담당자", "answered_by": "검토요청자", "answered_via": "검토요청경로"},
          "output": {"경영관리담당자명": "fin_name", "error_message": "error_message"}
        }</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Bnd_Record_Review" name="기록 거절" attachedToRef="Record_Review">
      <bpmn:errorEventDefinition errorRef="Err_record"/>
    </bpmn:boundaryEvent>

    <bpmn:userTask id="Accept_FIN" name="손익분석 보고 인수">
      <bpmn:extensionElements>
        <chk:approval>{
          "title": "손익분석 보고 요청 인수",
          "answered_by_as": "경영관리인수자", "answered_via_as": "경영관리인수경로",
          "assignees": "경영관리담당자명",
          "description": "장면 1에서는 인수까지다 — 분석 보고 완료로 표시하지 않는다.",
          "show": ["계산ID", "이슈ID", "검토요청사유", "error_message"],
          "fields": [{"key": "경영관리인수의견", "label": "인수 의견", "type": "text"}]
        }</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>

    <bpmn:serviceTask id="Record_FIN" name="손익분석 인수 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{
          "app_id": "nowview-sc01", "operation": "record_acceptance",
          "input": {"demo_run_id": "데모실행ID", "node_id": "'Accept_FIN'", "run_id": "계산ID", "answered_by": "경영관리인수자", "answered_via": "경영관리인수경로"},
          "output": {"error_message": "error_message"}
        }</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Bnd_Record_FIN" name="기록 거절" attachedToRef="Record_FIN">
      <bpmn:errorEventDefinition errorRef="Err_record"/>
    </bpmn:boundaryEvent>

    <bpmn:inclusiveGateway id="Gw_Join" name="후속 인수 모으기"/>

    <!-- S08 인계 판정 — 조건을 다시 확인하고 SCENE_HANDED_OFF를 한 번만 남긴다(UI06-01) -->
    <bpmn:serviceTask id="Task_Handoff" name="장면 인계 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{
          "app_id": "nowview-sc01", "operation": "hand_off",
          "input": {"demo_run_id": "데모실행ID", "run_id": "계산ID"},
          "output": {"인계완료": "handed_off"}
        }</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End" name="장면 1 인계 완료"/>

    <bpmn:sequenceFlow id="Flow_start" sourceRef="Start" targetRef="Task_Validate"/>
    <bpmn:sequenceFlow id="Flow_validated" sourceRef="Task_Validate" targetRef="Approve_DQ"/>
    <bpmn:sequenceFlow id="Flow_dq" sourceRef="Approve_DQ" targetRef="Record_DQ"/>
    <bpmn:sequenceFlow id="Flow_dq_recorded" sourceRef="Record_DQ" targetRef="Gw_DQ"/>
    <bpmn:sequenceFlow id="Flow_dq_ok" name="확인완료" sourceRef="Gw_DQ" targetRef="Confirm_Calc">
      <bpmn:conditionExpression>확인결과 == '확인완료' and 검증통과</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_dq_fix" name="보완 필요" sourceRef="Gw_DQ" targetRef="Wait_Correction"/>
    <bpmn:sequenceFlow id="Flow_corrected" sourceRef="Wait_Correction" targetRef="Task_Validate"/>
    <bpmn:sequenceFlow id="Flow_calc" sourceRef="Confirm_Calc" targetRef="Task_Calc"/>
    <bpmn:sequenceFlow id="Flow_calced" sourceRef="Task_Calc" targetRef="Task_AgentRequest"/>
    <bpmn:sequenceFlow id="Flow_agent" sourceRef="Task_AgentRequest" targetRef="Approve_Sales"/>
    <bpmn:sequenceFlow id="Flow_sales" sourceRef="Approve_Sales" targetRef="Record_Sales"/>
    <bpmn:sequenceFlow id="Flow_sales_recorded" sourceRef="Record_Sales" targetRef="Gw_Route"/>
    <bpmn:sequenceFlow id="Flow_ops" name="현업 검토(항상)" sourceRef="Gw_Route" targetRef="Approve_Dispatch">
      <bpmn:conditionExpression>true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_review" name="중요 또는 수동 요청" sourceRef="Gw_Route" targetRef="Approve_Review">
      <bpmn:conditionExpression>위험수준 == 'CRITICAL' or 경영검토요청</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_dispatched" sourceRef="Approve_Dispatch" targetRef="Record_Dispatch"/>
    <bpmn:sequenceFlow id="Flow_dispatch_recorded" sourceRef="Record_Dispatch" targetRef="Gw_Ops_Split"/>
    <bpmn:sequenceFlow id="Flow_prod" sourceRef="Gw_Ops_Split" targetRef="Accept_PROD"/>
    <bpmn:sequenceFlow id="Flow_mat" sourceRef="Gw_Ops_Split" targetRef="Accept_MAT"/>
    <bpmn:sequenceFlow id="Flow_prod_done" sourceRef="Accept_PROD" targetRef="Record_PROD"/>
    <bpmn:sequenceFlow id="Flow_prod_recorded" sourceRef="Record_PROD" targetRef="Gw_Ops_Join"/>
    <bpmn:sequenceFlow id="Flow_mat_done" sourceRef="Accept_MAT" targetRef="Record_MAT"/>
    <bpmn:sequenceFlow id="Flow_mat_recorded" sourceRef="Record_MAT" targetRef="Gw_Ops_Join"/>
    <bpmn:sequenceFlow id="Flow_ops_done" sourceRef="Gw_Ops_Join" targetRef="Gw_Join"/>
    <bpmn:sequenceFlow id="Flow_requested" sourceRef="Approve_Review" targetRef="Record_Review"/>
    <bpmn:sequenceFlow id="Flow_review_recorded" sourceRef="Record_Review" targetRef="Accept_FIN"/>
    <bpmn:sequenceFlow id="Flow_fin_done" sourceRef="Accept_FIN" targetRef="Record_FIN"/>
    <bpmn:sequenceFlow id="Flow_fin_recorded" sourceRef="Record_FIN" targetRef="Gw_Join"/>
    <bpmn:sequenceFlow id="Flow_join" sourceRef="Gw_Join" targetRef="Task_Handoff"/>
    <bpmn:sequenceFlow id="Flow_dq_rejected" name="기록 거절 — 다시 답한다" sourceRef="Bnd_Record_DQ" targetRef="Approve_DQ"/>
    <bpmn:sequenceFlow id="Flow_sales_rejected" name="기록 거절 — 다시 답한다" sourceRef="Bnd_Record_Sales" targetRef="Approve_Sales"/>
    <bpmn:sequenceFlow id="Flow_dispatch_rejected" name="기록 거절 — 다시 답한다" sourceRef="Bnd_Record_Dispatch" targetRef="Approve_Dispatch"/>
    <bpmn:sequenceFlow id="Flow_prod_rejected" name="기록 거절 — 다시 답한다" sourceRef="Bnd_Record_PROD" targetRef="Accept_PROD"/>
    <bpmn:sequenceFlow id="Flow_mat_rejected" name="기록 거절 — 다시 답한다" sourceRef="Bnd_Record_MAT" targetRef="Accept_MAT"/>
    <bpmn:sequenceFlow id="Flow_review_rejected" name="기록 거절 — 다시 답한다" sourceRef="Bnd_Record_Review" targetRef="Approve_Review"/>
    <bpmn:sequenceFlow id="Flow_fin_rejected" name="기록 거절 — 다시 답한다" sourceRef="Bnd_Record_FIN" targetRef="Accept_FIN"/>
    <bpmn:sequenceFlow id="Flow_end" sourceRef="Task_Handoff" targetRef="End"/>
  </bpmn:process>
</bpmn:definitions>
