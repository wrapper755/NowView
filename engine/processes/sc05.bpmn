    <bpmn:sequenceFlow id="Flow_urgent" name="긴급 기안" sourceRef="Gw_Respond" targetRef="Approve_Urgent">
      <bpmn:conditionExpression>대응 == 'URGENT'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_normal" name="정상 대응" sourceRef="Gw_Respond" targetRef="Execute_Order"/>
    <bpmn:sequenceFlow id="Flow_urgent_recorded" sourceRef="Record_Approve_Urgent" targetRef="Gw_Urgent"/>
    <bpmn:sequenceFlow id="Flow_urgent_returned" name="반려 — 대응 재검토" sourceRef="Gw_Urgent" targetRef="Respond_Change">
      <bpmn:conditionExpression>긴급결정 == '반려'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_urgent_approved" name="승인" sourceRef="Gw_Urgent" targetRef="Execute_Order"/>
