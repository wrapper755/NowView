      <bpmn:conditionExpression>OP51예산결정 == '반려'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_op51_approved" name="승인 · 약정" sourceRef="Gw_Budget_OP51" targetRef="Gw_Ready_Join"/>
    <bpmn:sequenceFlow id="Flow_ready_joined" sourceRef="Gw_Ready_Join" targetRef="Start_Operation"/>
