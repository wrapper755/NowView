<?xml version="1.0" encoding="UTF-8"?>
<!--
  SC05 — 결정 실행과 계획 갱신(장면 5). 업무 흐름의 유일한 원천이다(장면 1~4와 같다).

  BPM이 쥐는 것: 순서 · 사람 대기(계획 초안·생산 협조·확정·경영관리 확인·변경 요청·조건 근거·준비·충족·지원 이행·품의
  상신·현업·예산 승인·착수·변경 접수·공유·구매 확인·대응·긴급 승인·발주 기록·초기 결과·운영계획 확정·확인·전망 작성·부서
  확인·제출·대표 승인·게시·인계) · 분기(보완 요청·보완 필요 · 범위 이탈 시행 보류 · 반려 · 긴급/정상 · 대사 실패) · 후속
  인계. 쥐지 않는 것: 착수 요건·예산·초기 결과·전망 숫자 — 서비스 태스크가 NowView 계산 서비스(`nowview-sc05`)를 부른다.

  단계 대응(업무설계표 SC05-S01~S18): 착수(S01, 화면 명령 — 이 그림은 착수된 장면을 연다) → S02~S04 계획 초안·협조·
  확정·확인 → S05·S06 범위 내 변경 → S07~S09 CON41 ∥ SUP41 ∥ REQ51 ∥ OP51(병렬) → S10 착수 → S11·S12 대표 변경 건
  (정상 CH51 → 긴급 CH52, 고리) → S13 초기 결과 → S14·S15 OPL51 ∥ OPL52 ∥ OPL53 → S16 전망 작성·부서 확인(병렬)·제출 →
  S17 대표 승인·게시 → S18 인계. Agent 초안(AG51~AG58)은 BPM 밖의 명령이다 — 사람의 확정·승인을 대신하지 않는다.

  **Studio 시험 실행·Center 서버 실행에서 돈다**(장면 1~4 N1~N6과 같은 틀). 서비스 태스크는 외부 확장 `nowview-sc05`
  (`chaeksas/nowview-sc05.extension.json`)의 HTTP 작업이고 본문마다 `{{run_id}}`로 데모 실행을 묶는다. 결재에 답한 사람은
  `answered_by_as`·`answered_via_as`로 받아 기록 작업에 싣는다. 기록이 거절되면 오류 경계로 **같은 결재로 되돌아간다**.
  병렬 갈래끼리 변수가 겹치지 않게 폼 칸 이름에 대상을 붙였다(CON41근거 · REQ51요청액 · OPL51관리확인 …). 금액·수량 칸은
  text다 — 빈 값을 null로 보내지 않고 빈 글로 남겨 「미입력」으로 검사한다(비용 0과 미입력은 다르다).
  역할은 `app/sc05/domain.py`의 NODE_ROLES, 결재 담당자 이름은 `chk:approval.assignees` — 시험이 맞춰 본다.
  이 파일은 손으로 고쳐도 된다 — 생성기는 남기지 않았다.
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:chk="urn:chaeksas:bpmn:1" id="Defs_sc05">
  <bpmn:error id="Err_record" name="기록 거절" errorCode="TASK_FAILED"/>
  <bpmn:process id="nowview.sc05" name="SC05 결정 실행과 계획 갱신" isExecutable="true">
    <bpmn:extensionElements>
      <chk:process>{"run_location": "server", "service_keys": {"nowview-sc05": "nowview"}, "extensions": [{"id": "nowview-sc05", "version": "&gt;=0.1.0,&lt;1"}], "inputs": [{"name": "데모실행ID", "type": "string", "required": true}]}</chk:process>
    </bpmn:extensionElements>
    <bpmn:startEvent id="Start" name="장면 5 착수"/>
    <bpmn:serviceTask id="Task_Open" name="장면 열기">
      <bpmn:extensionElements>
        <chk:serviceCall>{"app_id": "nowview-sc05", "operation": "open_scene", "input": {"demo_run_id": "데모실행ID"}, "output": {"검토ID": "review_id", "과제ID": "task_id", "책임자명": "owner_name", "승인예산": "budget"}}</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="Draft_Plan" name="상세 계획 초안">
      <bpmn:extensionElements>
        <chk:approval>{"title": "U502 ACT42 긴급구매 축소 — 상세 실행계획 초안", "answered_by_as": "계획작성자", "answered_via_as": "계획작성경로", "assignees": ["서도현"], "description": "승인 범위(예산 6백만원·효과 개시 9월·과제 기한 9/30) 안에서 활동·담당·일정·선행관계·협조·비용·완료 근거를 쓴다. Agent 초안(AG51)을 불러와 고쳐도 된다 — 원 제안과 수정본은 따로 남는다. 누락은 저장되고 확정에서 막힌다.", "show": ["검토ID", "error_message"], "fields": [{"key": "계획활동", "label": "번호|활동|담당|시작|종료|선행|협조|비용|완료근거|근거ID — 한 줄에 활동 하나. 비용 빈칸은 미입력(0원과 다르다)", "type": "text", "required": true}, {"key": "효과확인기준", "label": "효과 확인 기준·자료 원천", "type": "text", "required": true}, {"key": "계획초안출처", "label": "인용한 Agent 초안 id(없으면 비움)", "type": "text", "required": false}, {"key": "계획작성메모", "label": "메모", "type": "text", "required": false}]}</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="Record_Draft_Plan" name="상세 계획 초안 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{"app_id": "nowview-sc05", "operation": "draft_plan", "input": {"demo_run_id": "데모실행ID", "node_id": "'Draft_Plan'", "task_id": "'ACT42'", "activities": "계획활동", "effect_rule": "효과확인기준", "agent_ref": "계획초안출처", "memo": "계획작성메모", "answered_by": "계획작성자", "answered_via": "계획작성경로"}, "output": {"계획ID": "plan_id", "계획누락": "missing", "error_message": "error_message"}}</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="Coordinate_Plan" name="생산 협조 확인">
      <bpmn:extensionElements>
        <chk:approval>{"title": "U502 생산 협조 확인 — 현재 계획 버전", "answered_by_as": "협조확인자", "answered_via_as": "협조확인경로", "assignees": ["권태윤"], "description": "생산 임원이 이 계획 버전의 실행 가능성과 생산 협조 책임을 확인한다. 정례 공유 이후 변경 누락 가능성 등 애로를 적는다.", "show": ["계획ID", "계획누락", "error_message"], "fields": [{"key": "협조결정", "label": "협조 확인", "type": "choice", "required": true, "choices": ["확인", "보완요청"]}, {"key": "협의내용", "label": "협의 내용·애로", "type": "text", "required": true}, {"key": "협조창구", "label": "생산 협조 담당(이름)", "type": "text", "required": false}, {"key": "협조근거", "label": "근거 ID", "type": "text", "required": false}]}</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="Record_Coordinate_Plan" name="생산 협조 확인 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{"app_id": "nowview-sc05", "operation": "coordinate_plan", "input": {"demo_run_id": "데모실행ID", "node_id": "'Coordinate_Plan'", "phase": "'initial'", "decision": "협조결정", "content": "협의내용", "contact": "협조창구", "evidence": "협조근거", "answered_by": "협조확인자", "answered_via": "협조확인경로"}, "output": {"error_message": "error_message"}}</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="Confirm_Plan" name="계획 확정">
      <bpmn:extensionElements>
        <chk:approval>{"title": "U502 ACT42 상세 계획 확정 — 구매 임원", "answered_by_as": "계획확정자", "answered_via_as": "계획확정경로", "assignees": ["문지후"], "description": "필수값·일정·선행 관계·승인 범위(예산·효과 개시·최종 기한)를 서버가 검사한다. 확정은 조건 충족·착수가 아니다.", "show": ["계획ID", "error_message"], "fields": [{"key": "확정결정", "label": "확정", "type": "choice", "required": true, "choices": ["확정", "보완요청"]}, {"key": "범위영향", "label": "승인 범위 영향 확인(확정이면 필수)", "type": "text", "required": false}, {"key": "확정의견", "label": "의견(보완 요청이면 필수)", "type": "text", "required": false}]}</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="Record_Confirm_Plan" name="계획 확정 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{"app_id": "nowview-sc05", "operation": "confirm_plan", "input": {"demo_run_id": "데모실행ID", "node_id": "'Confirm_Plan'", "phase": "'initial'", "decision": "확정결정", "impact": "범위영향", "comment": "확정의견", "answered_by": "계획확정자", "answered_via": "계획확정경로"}, "output": {"error_message": "error_message"}}</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="Verify_Plan" name="경영관리 확인">
      <bpmn:extensionElements>
        <chk:approval>{"title": "U502 경영관리 확인 — 승인 조건·예산·손익 가정 정합성", "answered_by_as": "관리확인자", "answered_via_as": "관리확인자경로", "assignees": ["강민서"], "description": "확정 권한과 확인 권한은 다르다. 확인하면 이 버전이 유효 계획이 된다. 이견이면 보완 필요와 사유 — 착수 요건 미충족으로 남는다.", "show": ["계획ID", "error_message"], "fields": [{"key": "관리확인", "label": "확인", "type": "choice", "required": true, "choices": ["확인", "보완필요"]}, {"key": "관리의견", "label": "의견(보완 필요면 필수)", "type": "text", "required": false}]}</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="Record_Verify_Plan" name="경영관리 확인 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{"app_id": "nowview-sc05", "operation": "verify_plan", "input": {"demo_run_id": "데모실행ID", "node_id": "'Verify_Plan'", "phase": "'initial'", "decision": "관리확인", "comment": "관리의견", "answered_by": "관리확인자", "answered_via": "관리확인자경로"}, "output": {"유효계획": "pointer", "error_message": "error_message"}}</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="Request_Change" name="계획 변경 요청">
      <bpmn:extensionElements>
        <chk:approval>{"title": "U502 준비 중 계획 변경 요청 — 승인 범위 안", "answered_by_as": "변경요청자", "answered_via_as": "변경요청경로", "assignees": ["서도현"], "description": "확정본을 복제한 새 버전에 변경 활동·사유·영향을 둔다. 기존 확정본은 그대로 유효하다. 예산·효과 개시·최종 기한이 승인 범위를 벗어나면 별도 승인 전 시행 보류다.", "show": ["유효계획", "error_message"], "fields": [{"key": "변경여부", "label": "변경", "type": "choice", "required": true, "choices": ["변경요청", "변경없음"]}, {"key": "변경활동", "label": "번호|활동|담당|시작|종료|선행|협조|비용|완료근거|근거ID — 한 줄에 활동 하나. 비용 빈칸은 미입력(0원과 다르다)", "type": "text", "required": false}, {"key": "변경사유", "label": "변경 사유", "type": "text", "required": false}, {"key": "변경영향", "label": "영향(예산·개시·기한)", "type": "text", "required": false}, {"key": "변경예산", "label": "승인예산(원)", "type": "text", "required": false, "default": "6000000"}, {"key": "변경개시", "label": "효과 개시(YYYY-MM-DD)", "type": "text", "required": false, "default": "2027-09-01"}, {"key": "변경기한", "label": "과제 기한", "type": "text", "required": false, "default": "2027-09-30T18:00:00+09:00"}, {"key": "변경초안출처", "label": "인용한 Agent 초안 id", "type": "text", "required": false}]}</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="Record_Request_Change" name="계획 변경 요청 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{"app_id": "nowview-sc05", "operation": "request_change", "input": {"demo_run_id": "데모실행ID", "node_id": "'Request_Change'", "decision": "변경여부", "activities": "변경활동", "reason": "변경사유", "impact": "변경영향", "budget": "변경예산", "effect_start": "변경개시", "due_at": "변경기한", "agent_ref": "변경초안출처", "answered_by": "변경요청자", "answered_via": "변경요청경로"}, "output": {"변경상태": "state", "변경계획ID": "plan_id", "error_message": "error_message"}}</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="Coordinate_Change" name="변경 협조 확인">
      <bpmn:extensionElements>
        <chk:approval>{"title": "U502 변경안 생산 협조 확인", "answered_by_as": "변경협조자", "answered_via_as": "변경협조경로", "assignees": ["권태윤"], "description": "변경안의 대행·수시 확인 절차와 교육 순서를 생산 임원이 확인한다.", "show": ["변경계획ID", "error_message"], "fields": [{"key": "변경협조결정", "label": "협조 확인", "type": "choice", "required": true, "choices": ["확인", "보완요청"]}, {"key": "변경협의내용", "label": "협의 내용", "type": "text", "required": true}, {"key": "변경협조창구", "label": "생산 협조 담당(이름)", "type": "text", "required": false}, {"key": "변경협조근거", "label": "근거 ID", "type": "text", "required": false}]}</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="Record_Coordinate_Change" name="변경 협조 확인 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{"app_id": "nowview-sc05", "operation": "coordinate_plan", "input": {"demo_run_id": "데모실행ID", "node_id": "'Coordinate_Change'", "phase": "'change'", "decision": "변경협조결정", "content": "변경협의내용", "contact": "변경협조창구", "evidence": "변경협조근거", "answered_by": "변경협조자", "answered_via": "변경협조경로"}, "output": {"error_message": "error_message"}}</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="Confirm_Change" name="변경 확정">
      <bpmn:extensionElements>
        <chk:approval>{"title": "U502 범위 내 변경 확정 — 구매 임원(대표 재승인 없음)", "answered_by_as": "변경확정자", "answered_via_as": "변경확정경로", "assignees": ["문지후"], "description": "예산·효과 개시·최종 기한 유지 여부를 확인해 변경을 확정한다. 승인 범위 안이라 대표에게 다시 승인받지 않는다.", "show": ["변경계획ID", "error_message"], "fields": [{"key": "변경확정결정", "label": "확정", "type": "choice", "required": true, "choices": ["확정", "보완요청"]}, {"key": "변경범위영향", "label": "승인 범위 영향 확인(확정이면 필수)", "type": "text", "required": false}, {"key": "변경확정의견", "label": "의견", "type": "text", "required": false}]}</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="Record_Confirm_Change" name="변경 확정 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{"app_id": "nowview-sc05", "operation": "confirm_plan", "input": {"demo_run_id": "데모실행ID", "node_id": "'Confirm_Change'", "phase": "'change'", "decision": "변경확정결정", "impact": "변경범위영향", "comment": "변경확정의견", "answered_by": "변경확정자", "answered_via": "변경확정경로"}, "output": {"error_message": "error_message"}}</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="Verify_Change" name="변경 경영관리 확인">
