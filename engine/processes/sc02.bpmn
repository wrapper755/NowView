<?xml version="1.0" encoding="UTF-8"?>
<!--
  SC02 — 구매·외주 단가 인상 검토와 수익성 영향의 경영검토 연결(장면 2).

  업무 흐름의 유일한 원천이다(SC01과 같다). Chaeksas 엔진이 이 파일을 그대로 해석한다. DI는 없다.

  BPM이 쥐는 것: 순서 · 사람 대기(확인·보고·협상·기안·결재·등록·인수) · 분기(보완·반려·추가 협상지시·
  대표 대상) · 인계.
  BPM이 쥐지 않는 것: 구매 증가·위험·승인선·손익 계산 — 서비스 태스크가 NowView 계산 서비스
  (`nowview-sc02`)를 부른다. 엔진은 숫자를 모른다(AG-21).

  단계 대응(업무설계표 S01~S14): S01 접수(CT21) → S02 팀장 보고(CT22) → S03 요청안 분석(CT23·24) →
  S04 1차 협상(CT25) → S05 협상안 재분석 → S06 기안(CT26) → S07 팀장 → S08 임원 → S09 대표 대상 판단
  (CT28) → S10 대표 → S11 원가 등록(CT29) → S12 장면 3 자료 연결 → S13 경영관리 인수(CT30).
  S14 추가 협상지시는 임원·대표 결재의 분기다 — 재협상 대기로 끝나고 2차 협상은 후속 범위다.

  **Studio 시험 실행·Center 서버 실행에서 돈다**(SC01 N1~N6과 같은 틀). 서비스 태스크는 외부 확장 `nowview-sc02`
  (`chaeksas/nowview-sc02.extension.json`)의 HTTP 작업이고, 본문마다 `{{run_id}}`로 데모 실행을 묶는다. 결재에 답한
  사람은 `answered_by_as`·`answered_via_as`로 받아 기록 작업에 싣는다. 기록이 거절되면 오류 경계로 **같은 결재로
  되돌아간다**(`Bnd_Record_*`). 엔진 안의 내장 실행기도 같은 그림을 돌린다 — 화면에서는 고르지 않고 시험이 쓴다.
  역할 검사는 `app/sc02/domain.py`의 NODE_ROLES, 결재 담당자 이름은 `chk:approval.assignees` — 테스트가 맞춰 본다.
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:chk="urn:chaeksas:bpmn:1" id="Defs_sc02">
  <bpmn:error id="Err_record" name="기록 거절" errorCode="TASK_FAILED"/>
  <bpmn:process id="nowview.sc02" name="SC02 단가 인상 검토와 경영검토 연결" isExecutable="true">
    <bpmn:extensionElements>
      <chk:process>{
        "run_location": "server",
        "service_keys": {"nowview-sc02": "nowview"},
        "extensions": [{"id": "nowview-sc02", "version": "&gt;=0.1.0,&lt;1"}],
        "inputs": [
          {"name": "데모실행ID", "type": "string", "required": true},
          {"name": "요청ID", "type": "string", "required": true}
        ]
      }</chk:process>
    </bpmn:extensionElements>

    <bpmn:startEvent id="Start" name="단가 인상 요청 접수"/>

    <!-- S01 CT21 필수값·공급사-품목 매핑·기존가 대조(U21-02) -->
    <bpmn:serviceTask id="Task_Screen" name="요청 자동 검사">
      <bpmn:extensionElements>
        <chk:serviceCall>{
          "app_id": "nowview-sc02", "operation": "screen_request",
          "input": {"demo_run_id": "데모실행ID", "request_id": "요청ID"},
          "output": {"검사통과": "passed", "검사오류수": "error_count"}
        }</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <bpmn:userTask id="Verify_Request" name="요청 원문 확인">
      <bpmn:extensionElements>
        <chk:approval>{
          "title": "단가 인상 요청 원문 대조",
          "answered_by_as": "확인자", "answered_via_as": "확인경로",
          "assignees": ["윤채원"],
          "description": "공문과 등록 내용(공급사·품목·기존가·요청가·적용일·VAT 제외)을 대조한다. 요청가는 승인 원가가 아니다.",
          "show": ["요청ID", "검사통과", "검사오류수", "error_message"],
          "fields": [
            {"key": "확인결과", "label": "확인 결과", "type": "choice", "required": true,
             "choices": ["확인완료", "보완요청"]},
            {"key": "확인의견", "label": "확인 의견", "type": "text", "required": true}
          ]
        }</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>

    <bpmn:serviceTask id="Record_Verify" name="원문 확인 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{
          "app_id": "nowview-sc02", "operation": "record_verification",
          "input": {"demo_run_id": "데모실행ID", "node_id": "'Verify_Request'", "request_id": "요청ID", "result": "확인결과", "opinion": "확인의견", "answered_by": "확인자", "answered_via": "확인경로"},
          "output": {"error_message": "error_message"}
        }</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gw_Verify" name="원문 확인 결과" default="Flow_verify_fix"/>

    <!-- S02 CT22 구두보고 기록 — 별도 승인 단계를 늘리지 않는다(구매담당이 협의 결과를 적는다) -->
    <bpmn:userTask id="Report_Lead" name="팀장 보고 기록">
      <bpmn:extensionElements>
        <chk:approval>{
          "title": "구매팀장 구두보고 결과",
          "answered_by_as": "보고자", "answered_via_as": "보고경로",
          "assignees": ["윤채원"],
          "description": "팀장과 협의한 결과를 적는다. 전자 승인이 아니다.",
          "show": ["요청ID", "error_message"],
          "fields": [
            {"key": "참여자", "label": "참여자", "type": "text", "required": true},
            {"key": "요청요약", "label": "요청 요약", "type": "text", "required": true},
            {"key": "검토필요성", "label": "검토 필요성", "type": "choice", "required": true,
             "choices": ["검토진행", "검토종결"]},
            {"key": "협상방향", "label": "협상 방향", "type": "text"},
            {"key": "보고결론", "label": "결론 (종결이면 사유)", "type": "text", "required": true}
          ]
        }</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>

    <bpmn:serviceTask id="Record_Report" name="보고 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{
          "app_id": "nowview-sc02", "operation": "record_report",
          "input": {"demo_run_id": "데모실행ID", "node_id": "'Report_Lead'", "participants": "참여자", "summary": "요청요약", "need": "검토필요성", "direction": "협상방향", "conclusion": "보고결론", "answered_by": "보고자", "answered_via": "보고경로"},
          "output": {"error_message": "error_message"}
        }</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gw_Report" name="검토 필요성" default="Flow_report_closed"/>

    <!-- S03 요청안 영향분석 + 내부 협상 검토안. 외부 협상기한은 담당자가 건별로 넣는다(U23-02) -->
    <bpmn:userTask id="Confirm_Analysis" name="요청안 영향분석">
      <bpmn:extensionElements>
        <chk:approval>{
          "title": "요청안 분석 · 내부 협상 검토안",
          "answered_by_as": "분석요청자", "answered_via_as": "분석요청경로",
          "assignees": ["윤채원"],
          "description": "요청안과 내부 제시안을 같은 F02·C01 기준으로 계산한다. 외부 협상기한은 내부 업무기한과 따로다.",
          "show": ["요청ID"],
          "fields": [
            {"key": "내부제시단가", "label": "내부 협상 제시 단가(원)", "type": "number", "required": true},
            {"key": "협상기한", "label": "외부 협상기한 (KST, 예 2027-06-21T18:00:00+09:00)", "type": "text", "required": true},
            {"key": "분석메모", "label": "메모", "type": "text"}
          ]
        }</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_Analyze" name="요청안·제시안 분석">
      <bpmn:extensionElements>
        <chk:serviceCall>{
          "app_id": "nowview-sc02", "operation": "analyze_request",
          "input": {"demo_run_id": "데모실행ID", "request_id": "요청ID", "offer_price": "내부제시단가", "due_at": "협상기한", "answered_by": "분석요청자", "answered_via": "분석요청경로"},
          "output": {"요청분석ID": "request_run", "제시분석ID": "offer_run", "위험수준": "risk"}
        }</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <!-- AG21 사전 검토 초안 — 기다리지 않는다. Agent 실패는 사람 검토를 막지 않는다(X09-B) -->
    <bpmn:serviceTask id="Task_Agent_Pre" name="Agent 사전 검토 초안">
      <bpmn:extensionElements>
        <chk:serviceCall>{
          "app_id": "nowview-sc02", "operation": "agent_draft",
          "input": {"demo_run_id": "데모실행ID", "kind": "'AG21'", "run_id": "요청분석ID"},
          "output": {"사전초안ID": "output_id"}
        }</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <!-- S04 CT25 1차 협상 — 잠정안은 회사 승인이 아니다. 가격 인하를 성공 조건으로 강제하지 않는다 -->
    <bpmn:userTask id="Record_Negotiation" name="1차 협상 결과">
      <bpmn:extensionElements>
        <chk:approval>{
          "title": "1차 협상 결과 기록",
          "answered_by_as": "협상기록자", "answered_via_as": "협상기록경로",
          "assignees": ["윤채원"],
          "description": "기존가·요청가·내부제시가와 구분해 협상가·적용일을 적는다. 미합의면 단가를 비워 둔다(0원이 아니다).",
          "show": ["요청ID", "요청분석ID", "제시분석ID", "위험수준", "error_message"],
          "fields": [
            {"key": "협상결과", "label": "협상 결과", "type": "choice", "required": true,
             "choices": ["잠정합의", "미합의"]},
            {"key": "협상단가", "label": "잠정 단가(원) — 미합의면 비움", "type": "number"},
            {"key": "협상적용일", "label": "적용일 (월초, 예 2027-07-01)", "type": "text", "required": true},
            {"key": "협상참석자", "label": "참석자", "type": "text", "required": true},
            {"key": "미합의사항", "label": "미합의 사항·잠정 조건", "type": "text"}
          ]
        }</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>

    <bpmn:serviceTask id="Record_Neg" name="협상 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{
          "app_id": "nowview-sc02", "operation": "record_negotiation",
          "input": {"demo_run_id": "데모실행ID", "node_id": "'Record_Negotiation'", "outcome": "협상결과", "price": "협상단가", "effective_date": "협상적용일", "participants": "협상참석자", "unresolved": "미합의사항", "answered_by": "협상기록자", "answered_via": "협상기록경로"},
          "output": {"협상ID": "negotiation_id", "error_message": "error_message"}
        }</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gw_Neg" name="협상 결과" default="Flow_neg_unresolved"/>

    <!-- S05 협상안 재분석 — 같은 F02·원가 기준, 요청안의 12개월로 부담 감소를 다시 잰다 -->
    <bpmn:userTask id="Confirm_Reanalysis" name="협상안 재분석">
      <bpmn:extensionElements>
        <chk:approval>{
          "title": "협상안 영향 재분석",
          "answered_by_as": "재분석요청자", "answered_via_as": "재분석요청경로",
          "assignees": ["윤채원"],
          "description": "가격·적용일이 바뀌면 새 run이다. 인상률이 줄어든 것을 위험 해소로 읽지 않는다.",
          "show": ["요청ID", "협상ID"],
          "fields": [{"key": "재분석메모", "label": "메모", "type": "text"}]
        }</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_Reanalyze" name="협상안 분석">
      <bpmn:extensionElements>
        <chk:serviceCall>{
          "app_id": "nowview-sc02", "operation": "analyze_negotiation",
          "input": {"demo_run_id": "데모실행ID", "negotiation_id": "협상ID", "answered_by": "재분석요청자", "answered_via": "재분석요청경로"},
          "output": {"협상분석ID": "run_id", "위험수준": "risk"}
        }</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <!-- AG22 협상 비교 · AG23 기안 문안 초안 -->
    <bpmn:serviceTask id="Task_Agent_Neg" name="Agent 협상 비교·기안 초안">
      <bpmn:extensionElements>
        <chk:serviceCall>{
          "app_id": "nowview-sc02", "operation": "agent_draft",
          "input": {"demo_run_id": "데모실행ID", "kind": "'AG22'", "run_id": "협상분석ID"},
          "output": {"협상초안ID": "output_id"}
        }</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <!-- S06 CT26 가격인상 보고 기안 — 상신이 기안 버전을 고정하고 그 버전의 분석 run을 만든다 -->
    <bpmn:userTask id="Draft_Proposal" name="가격인상 보고 기안">
      <bpmn:extensionElements>
        <chk:approval>{
          "title": "가격인상 보고 기안 · 상신",
          "answered_by_as": "기안자", "answered_via_as": "기안경로",
          "assignees": ["윤채원"],
          "description": "기안가·적용일이 협상안과 다르면 차이 사유가 필요하다. 상신하면 그 버전은 고칠 수 없다.",
          "show": ["요청ID", "협상ID", "협상분석ID", "error_message"],
          "fields": [
            {"key": "기안단가", "label": "기안 단가(원)", "type": "number", "required": true},
            {"key": "기안적용일", "label": "적용일 (월초)", "type": "text", "required": true},
            {"key": "인상필요성", "label": "인상 필요성", "type": "text", "required": true},
            {"key": "차이사유", "label": "협상안과 다른 경우 사유", "type": "text"}
          ]
        }</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>

    <bpmn:serviceTask id="Record_Proposal" name="기안 상신 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{
          "app_id": "nowview-sc02", "operation": "submit_proposal",
          "input": {"demo_run_id": "데모실행ID", "node_id": "'Draft_Proposal'", "price": "기안단가", "effective_date": "기안적용일", "reason": "인상필요성", "diff_reason": "차이사유", "answered_by": "기안자", "answered_via": "기안경로"},
          "output": {"기안ID": "proposal_id", "기안분석ID": "run_id", "대표대상예상": "ceo_expected", "error_message": "error_message"}
        }</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <!-- S07 CT27 구매팀장 -->
    <bpmn:userTask id="Approve_Lead" name="구매팀장 승인">
      <bpmn:extensionElements>
        <chk:approval>{
          "title": "가격인상 기안 — 구매팀장",
          "answered_by_as": "팀장결재자", "answered_via_as": "팀장결재경로",
          "assignees": ["서도현"],
          "description": "필요성·산출근거·협상 결과와 기안 일치를 본다. 보완은 새 기안 버전으로 팀장부터 다시 받는다.",
          "show": ["기안ID", "기안분석ID", "대표대상예상", "error_message"],
          "fields": [
            {"key": "결정", "label": "결정", "type": "choice", "required": true,
             "choices": ["승인", "보완", "반려"]},
            {"key": "결재의견", "label": "의견 (보완·반려는 사유)", "type": "text", "required": true}
          ]
        }</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>

    <bpmn:serviceTask id="Record_Lead" name="팀장 결정 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{
          "app_id": "nowview-sc02", "operation": "record_decision",
          "input": {"demo_run_id": "데모실행ID", "node_id": "'Approve_Lead'", "proposal_id": "기안ID", "decision": "결정", "comment": "결재의견", "condition": "''", "due_at": "''", "answered_by": "팀장결재자", "answered_via": "팀장결재경로"},
          "output": {"error_message": "error_message"}
        }</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gw_Lead" name="팀장 결정" default="Flow_lead_reject"/>

    <!-- S08 CT27·28 구매임원 — 추가 협상지시는 S14로 -->
    <bpmn:userTask id="Approve_Exec" name="구매임원 승인">
      <bpmn:extensionElements>
        <chk:approval>{
          "title": "가격인상 기안 — 구매임원",
          "answered_by_as": "임원결재자", "answered_via_as": "임원결재경로",
          "assignees": ["문지후"],
          "description": "인상 수용 필요성을 판단한다. 대표 승인 여부는 위험 등급이 아니라 금액 기준(AUTH02-v1)이 정한다.",
          "show": ["기안ID", "기안분석ID", "대표대상예상", "error_message"],
          "fields": [
            {"key": "결정", "label": "결정", "type": "choice", "required": true,
             "choices": ["승인", "보완", "반려", "추가협상지시"]},
            {"key": "결재의견", "label": "의견 (보완·반려·지시는 사유)", "type": "text", "required": true},
            {"key": "지시요구조건", "label": "추가 협상 요구조건", "type": "text"},
            {"key": "지시기한", "label": "추가 협상기한 (KST)", "type": "text"}
          ]
        }</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>

    <bpmn:serviceTask id="Record_Exec" name="임원 결정 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{
          "app_id": "nowview-sc02", "operation": "record_decision",
          "input": {"demo_run_id": "데모실행ID", "node_id": "'Approve_Exec'", "proposal_id": "기안ID", "decision": "결정", "comment": "결재의견", "condition": "지시요구조건", "due_at": "지시기한", "answered_by": "임원결재자", "answered_via": "임원결재경로"},
          "output": {"error_message": "error_message"}
        }</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gw_Exec" name="임원 결정" default="Flow_exec_reject"/>

    <!-- S09 CT28 대표 승인 대상 판단 — 최종 기안의 향후 12개월 구매 증가 ≥ 1천만원 -->
    <bpmn:serviceTask id="Task_Authority" name="대표 승인 대상 판단">
      <bpmn:extensionElements>
        <chk:serviceCall>{
          "app_id": "nowview-sc02", "operation": "judge_authority",
          "input": {"demo_run_id": "데모실행ID", "proposal_id": "기안ID"},
          "output": {"대표대상": "ceo_required"}
        }</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gw_Authority" name="대표 대상" default="Flow_no_ceo"/>

    <!-- S10 대표이사 -->
    <bpmn:userTask id="Approve_CEO" name="대표이사 승인">
      <bpmn:extensionElements>
        <chk:approval>{
          "title": "가격인상 기안 — 대표이사",
          "answered_by_as": "대표결재자", "answered_via_as": "대표결재경로",
          "assignees": ["임하준"],
          "description": "같은 기안 버전과 이전 승인 이력을 본다. 단가안 승인은 공식 전망 승인이 아니다.",
          "show": ["기안ID", "기안분석ID", "대표대상", "error_message"],
          "fields": [
            {"key": "결정", "label": "결정", "type": "choice", "required": true,
             "choices": ["승인", "보완", "반려", "추가협상지시"]},
            {"key": "결재의견", "label": "의견 (보완·반려·지시는 사유)", "type": "text", "required": true},
            {"key": "지시요구조건", "label": "추가 협상 요구조건", "type": "text"},
            {"key": "지시기한", "label": "추가 협상기한 (KST)", "type": "text"}
          ]
        }</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>

    <bpmn:serviceTask id="Record_CEO" name="대표 결정 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{
          "app_id": "nowview-sc02", "operation": "record_decision",
          "input": {"demo_run_id": "데모실행ID", "node_id": "'Approve_CEO'", "proposal_id": "기안ID", "decision": "결정", "comment": "결재의견", "condition": "지시요구조건", "due_at": "지시기한", "answered_by": "대표결재자", "answered_via": "대표결재경로"},
          "output": {"error_message": "error_message"}
        }</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gw_CEO" name="대표 결정" default="Flow_ceo_reject"/>

    <!-- S11 CT29 승인 조건 대조 · 원가 버전 등록 — 구매담당이 원가관리를 겸한다(Pilot) -->
    <bpmn:userTask id="Register_Cost" name="원가 적용 등록">
      <bpmn:extensionElements>
        <chk:approval>{
          "title": "승인 조건 대조 · 원가 버전 등록",
          "answered_by_as": "등록자", "answered_via_as": "등록경로",
          "assignees": ["윤채원"],
          "description": "최종 승인된 품목·단가·적용일·모델 범위만 등록한다. 다르면 기안 변경 절차로 돌린다. C01은 보존한다.",
          "show": ["기안ID", "error_message"],
          "fields": [
            {"key": "대조결과", "label": "승인 조건 대조", "type": "choice", "required": true,
             "choices": ["일치", "불일치"]},
            {"key": "등록메모", "label": "메모", "type": "text"}
          ]
        }</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>

    <bpmn:serviceTask id="Record_Cost" name="원가 등록 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{
          "app_id": "nowview-sc02", "operation": "register_cost",
          "input": {"demo_run_id": "데모실행ID", "node_id": "'Register_Cost'", "proposal_id": "기안ID", "check": "대조결과", "note": "등록메모", "answered_by": "등록자", "answered_via": "등록경로"},
          "output": {"원가버전": "cost_version_id", "error_message": "error_message"}
        }</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <!-- S12 CT30 장면 3 검토자료 연결 — 물량·원가 사건을 각각 두고 상위 검토건에 잇는다 -->
    <bpmn:userTask id="Request_Handoff" name="장면 3 검토자료 인계 요청">
      <bpmn:extensionElements>
        <chk:approval>{
          "title": "통합 영향 확인 · 경영관리 인계 요청",
          "answered_by_as": "인계요청자", "answered_via_as": "인계요청경로",
          "assignees": ["윤채원"],
          "description": "F01+C01 → F02+C01 → F02+승인 원가의 손익을 중복 없이 연결해 넘긴다.",
          "show": ["기안ID", "원가버전", "error_message"],
          "fields": [
            {"key": "경영관리담당자", "label": "경영관리 담당", "type": "text", "required": true},
            {"key": "인계메모", "label": "인계 메모", "type": "text", "required": true}
          ]
        }</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>

    <bpmn:serviceTask id="Record_Handoff" name="인계 요청 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{
          "app_id": "nowview-sc02", "operation": "request_handoff",
          "input": {"demo_run_id": "데모실행ID", "node_id": "'Request_Handoff'", "fin": "경영관리담당자", "note": "인계메모", "answered_by": "인계요청자", "answered_via": "인계요청경로"},
          "output": {"경영관리담당자명": "fin_name", "인계ID": "handoff_id", "error_message": "error_message"}
        }</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <!-- AG24 인계 요약 -->
    <bpmn:serviceTask id="Task_Agent_Handoff" name="Agent 인계 요약 초안">
      <bpmn:extensionElements>
        <chk:serviceCall>{
          "app_id": "nowview-sc02", "operation": "agent_draft",
          "input": {"demo_run_id": "데모실행ID", "kind": "'AG24'", "run_id": "기안분석ID"},
          "output": {"인계초안ID": "output_id"}
        }</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <!-- S13 경영관리 인수 — 손익 검토 완료나 위험 해소가 아니다 -->
    <bpmn:userTask id="Accept_Handoff" name="경영관리 인수">
      <bpmn:extensionElements>
        <chk:approval>{
          "title": "장면 2 검토자료 인수",
          "answered_by_as": "인수자", "answered_via_as": "인수경로",
          "assignees": "경영관리담당자명",
          "description": "범위·버전·근거 완전성을 확인하고 인수한다. 장면 3 손익 검토는 이제 시작이다.",
          "show": ["인계ID", "기안ID", "원가버전", "error_message"],
          "fields": [{"key": "인수의견", "label": "인수 의견", "type": "text", "required": true}]
        }</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>

    <bpmn:serviceTask id="Record_Accept" name="인수 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{
          "app_id": "nowview-sc02", "operation": "accept_handoff",
          "input": {"demo_run_id": "데모실행ID", "node_id": "'Accept_Handoff'", "handoff_id": "인계ID", "opinion": "인수의견", "answered_by": "인수자", "answered_via": "인수경로"},
          "output": {"error_message": "error_message"}
        }</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <bpmn:boundaryEvent id="Bnd_Record_Verify" name="기록 거절" attachedToRef="Record_Verify">
      <bpmn:errorEventDefinition errorRef="Err_record"/>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Bnd_Record_Report" name="기록 거절" attachedToRef="Record_Report">
      <bpmn:errorEventDefinition errorRef="Err_record"/>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Bnd_Record_Neg" name="기록 거절" attachedToRef="Record_Neg">
      <bpmn:errorEventDefinition errorRef="Err_record"/>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Bnd_Record_Proposal" name="기록 거절" attachedToRef="Record_Proposal">
      <bpmn:errorEventDefinition errorRef="Err_record"/>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Bnd_Record_Lead" name="기록 거절" attachedToRef="Record_Lead">
      <bpmn:errorEventDefinition errorRef="Err_record"/>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Bnd_Record_Exec" name="기록 거절" attachedToRef="Record_Exec">
      <bpmn:errorEventDefinition errorRef="Err_record"/>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Bnd_Record_CEO" name="기록 거절" attachedToRef="Record_CEO">
      <bpmn:errorEventDefinition errorRef="Err_record"/>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Bnd_Record_Cost" name="기록 거절" attachedToRef="Record_Cost">
      <bpmn:errorEventDefinition errorRef="Err_record"/>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Bnd_Record_Handoff" name="기록 거절" attachedToRef="Record_Handoff">
      <bpmn:errorEventDefinition errorRef="Err_record"/>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Bnd_Record_Accept" name="기록 거절" attachedToRef="Record_Accept">
      <bpmn:errorEventDefinition errorRef="Err_record"/>
    </bpmn:boundaryEvent>

    <bpmn:endEvent id="End" name="장면 2 인계 완료"/>
    <bpmn:endEvent id="End_NeedsInfo" name="자료 보완 대기"/>
    <bpmn:endEvent id="End_Closed" name="검토 종결"/>
    <bpmn:endEvent id="End_Unresolved" name="협상 미합의 — 팀장 협의"/>
    <bpmn:endEvent id="End_Rejected" name="반려 종결"/>
    <bpmn:endEvent id="End_Reneg" name="재협상 대기 (S14)"/>

    <bpmn:sequenceFlow id="Flow_start" sourceRef="Start" targetRef="Task_Screen"/>
    <bpmn:sequenceFlow id="Flow_screened" sourceRef="Task_Screen" targetRef="Verify_Request"/>
    <bpmn:sequenceFlow id="Flow_verify" sourceRef="Verify_Request" targetRef="Record_Verify"/>
    <bpmn:sequenceFlow id="Flow_verify_recorded" sourceRef="Record_Verify" targetRef="Gw_Verify"/>
    <bpmn:sequenceFlow id="Flow_verify_ok" name="확인완료" sourceRef="Gw_Verify" targetRef="Report_Lead">
      <bpmn:conditionExpression>확인결과 == '확인완료' and 검사통과</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_verify_fix" name="보완 필요" sourceRef="Gw_Verify" targetRef="End_NeedsInfo"/>
    <bpmn:sequenceFlow id="Flow_report" sourceRef="Report_Lead" targetRef="Record_Report"/>
    <bpmn:sequenceFlow id="Flow_report_recorded" sourceRef="Record_Report" targetRef="Gw_Report"/>
    <bpmn:sequenceFlow id="Flow_report_go" name="검토 진행" sourceRef="Gw_Report" targetRef="Confirm_Analysis">
      <bpmn:conditionExpression>검토필요성 == '검토진행'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_report_closed" name="검토 종결" sourceRef="Gw_Report" targetRef="End_Closed"/>
    <bpmn:sequenceFlow id="Flow_analysis" sourceRef="Confirm_Analysis" targetRef="Task_Analyze"/>
    <bpmn:sequenceFlow id="Flow_analyzed" sourceRef="Task_Analyze" targetRef="Task_Agent_Pre"/>
    <bpmn:sequenceFlow id="Flow_agent_pre" sourceRef="Task_Agent_Pre" targetRef="Record_Negotiation"/>
    <bpmn:sequenceFlow id="Flow_neg" sourceRef="Record_Negotiation" targetRef="Record_Neg"/>
    <bpmn:sequenceFlow id="Flow_neg_recorded" sourceRef="Record_Neg" targetRef="Gw_Neg"/>
    <bpmn:sequenceFlow id="Flow_neg_ok" name="잠정합의" sourceRef="Gw_Neg" targetRef="Confirm_Reanalysis">
      <bpmn:conditionExpression>협상결과 == '잠정합의'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_neg_unresolved" name="미합의" sourceRef="Gw_Neg" targetRef="End_Unresolved"/>
    <bpmn:sequenceFlow id="Flow_reanalysis" sourceRef="Confirm_Reanalysis" targetRef="Task_Reanalyze"/>
    <bpmn:sequenceFlow id="Flow_reanalyzed" sourceRef="Task_Reanalyze" targetRef="Task_Agent_Neg"/>
    <bpmn:sequenceFlow id="Flow_agent_neg" sourceRef="Task_Agent_Neg" targetRef="Draft_Proposal"/>
    <bpmn:sequenceFlow id="Flow_draft" sourceRef="Draft_Proposal" targetRef="Record_Proposal"/>
    <bpmn:sequenceFlow id="Flow_submitted" sourceRef="Record_Proposal" targetRef="Approve_Lead"/>
    <bpmn:sequenceFlow id="Flow_lead" sourceRef="Approve_Lead" targetRef="Record_Lead"/>
    <bpmn:sequenceFlow id="Flow_lead_recorded" sourceRef="Record_Lead" targetRef="Gw_Lead"/>
    <bpmn:sequenceFlow id="Flow_lead_ok" name="승인" sourceRef="Gw_Lead" targetRef="Approve_Exec">
      <bpmn:conditionExpression>결정 == '승인'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_lead_return" name="보완 — 새 기안 버전" sourceRef="Gw_Lead" targetRef="Draft_Proposal">
      <bpmn:conditionExpression>결정 == '보완'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_lead_reject" name="반려" sourceRef="Gw_Lead" targetRef="End_Rejected"/>
    <bpmn:sequenceFlow id="Flow_exec" sourceRef="Approve_Exec" targetRef="Record_Exec"/>
    <bpmn:sequenceFlow id="Flow_exec_recorded" sourceRef="Record_Exec" targetRef="Gw_Exec"/>
    <bpmn:sequenceFlow id="Flow_exec_ok" name="승인" sourceRef="Gw_Exec" targetRef="Task_Authority">
      <bpmn:conditionExpression>결정 == '승인'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_exec_return" name="보완 — 새 기안 버전" sourceRef="Gw_Exec" targetRef="Draft_Proposal">
      <bpmn:conditionExpression>결정 == '보완'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_exec_reneg" name="추가 협상지시" sourceRef="Gw_Exec" targetRef="End_Reneg">
      <bpmn:conditionExpression>결정 == '추가협상지시'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_exec_reject" name="반려" sourceRef="Gw_Exec" targetRef="End_Rejected"/>
    <bpmn:sequenceFlow id="Flow_authority" sourceRef="Task_Authority" targetRef="Gw_Authority"/>
    <bpmn:sequenceFlow id="Flow_ceo" name="12개월 증가 ≥ 1천만원" sourceRef="Gw_Authority" targetRef="Approve_CEO">
      <bpmn:conditionExpression>대표대상</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_no_ceo" name="대표 비대상 — 임원 최종" sourceRef="Gw_Authority" targetRef="Register_Cost"/>
    <bpmn:sequenceFlow id="Flow_ceo_answered" sourceRef="Approve_CEO" targetRef="Record_CEO"/>
    <bpmn:sequenceFlow id="Flow_ceo_recorded" sourceRef="Record_CEO" targetRef="Gw_CEO"/>
    <bpmn:sequenceFlow id="Flow_ceo_ok" name="승인" sourceRef="Gw_CEO" targetRef="Register_Cost">
      <bpmn:conditionExpression>결정 == '승인'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ceo_return" name="보완 — 새 기안 버전" sourceRef="Gw_CEO" targetRef="Draft_Proposal">
      <bpmn:conditionExpression>결정 == '보완'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ceo_reneg" name="추가 협상지시" sourceRef="Gw_CEO" targetRef="End_Reneg">
      <bpmn:conditionExpression>결정 == '추가협상지시'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ceo_reject" name="반려" sourceRef="Gw_CEO" targetRef="End_Rejected"/>
    <bpmn:sequenceFlow id="Flow_register" sourceRef="Register_Cost" targetRef="Record_Cost"/>
    <bpmn:sequenceFlow id="Flow_registered" sourceRef="Record_Cost" targetRef="Request_Handoff"/>
    <bpmn:sequenceFlow id="Flow_handoff" sourceRef="Request_Handoff" targetRef="Record_Handoff"/>
    <bpmn:sequenceFlow id="Flow_handoff_recorded" sourceRef="Record_Handoff" targetRef="Task_Agent_Handoff"/>
    <bpmn:sequenceFlow id="Flow_agent_handoff" sourceRef="Task_Agent_Handoff" targetRef="Accept_Handoff"/>
    <bpmn:sequenceFlow id="Flow_accept" sourceRef="Accept_Handoff" targetRef="Record_Accept"/>
    <bpmn:sequenceFlow id="Flow_Record_Verify_rejected" name="기록 거절 — 다시 답한다" sourceRef="Bnd_Record_Verify" targetRef="Verify_Request"/>
    <bpmn:sequenceFlow id="Flow_Record_Report_rejected" name="기록 거절 — 다시 답한다" sourceRef="Bnd_Record_Report" targetRef="Report_Lead"/>
    <bpmn:sequenceFlow id="Flow_Record_Neg_rejected" name="기록 거절 — 다시 답한다" sourceRef="Bnd_Record_Neg" targetRef="Record_Negotiation"/>
    <bpmn:sequenceFlow id="Flow_Record_Proposal_rejected" name="기록 거절 — 다시 답한다" sourceRef="Bnd_Record_Proposal" targetRef="Draft_Proposal"/>
    <bpmn:sequenceFlow id="Flow_Record_Lead_rejected" name="기록 거절 — 다시 답한다" sourceRef="Bnd_Record_Lead" targetRef="Approve_Lead"/>
    <bpmn:sequenceFlow id="Flow_Record_Exec_rejected" name="기록 거절 — 다시 답한다" sourceRef="Bnd_Record_Exec" targetRef="Approve_Exec"/>
    <bpmn:sequenceFlow id="Flow_Record_CEO_rejected" name="기록 거절 — 다시 답한다" sourceRef="Bnd_Record_CEO" targetRef="Approve_CEO"/>
    <bpmn:sequenceFlow id="Flow_Record_Cost_rejected" name="기록 거절 — 다시 답한다" sourceRef="Bnd_Record_Cost" targetRef="Register_Cost"/>
    <bpmn:sequenceFlow id="Flow_Record_Handoff_rejected" name="기록 거절 — 다시 답한다" sourceRef="Bnd_Record_Handoff" targetRef="Request_Handoff"/>
    <bpmn:sequenceFlow id="Flow_Record_Accept_rejected" name="기록 거절 — 다시 답한다" sourceRef="Bnd_Record_Accept" targetRef="Accept_Handoff"/>
    <bpmn:sequenceFlow id="Flow_end" sourceRef="Record_Accept" targetRef="End"/>
  </bpmn:process>
</bpmn:definitions>
