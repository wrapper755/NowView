    <!-- S14 CT409·CT410 종료 요건 검사 → HANDOFF41. 위험·전망·목표는 그대로다 -->
    <bpmn:userTask id="Complete_Scene" name="장면 4 완료">
      <bpmn:extensionElements>
        <chk:approval>{"title": "U408 장면 5 인계 · 장면 4 완료", "answered_by_as": "완료자", "answered_via_as": "완료경로", "assignees": ["정하윤"], "description": "승인서·회의록, 전체·개별 최신 인수, 조건·지원·추가 지시의 책임·기한을 서버가 다시 검사한다. CON41 미충족은 차단이 아니다. 장면 완료는 실행 완료·위험 해소·전망 승인이 아니다.", "show": ["승인서ID", "error_message"], "fields": [{"key": "완료메모", "label": "완료 메모", "type": "text", "required": true}]}</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>
