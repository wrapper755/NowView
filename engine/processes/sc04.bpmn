        <chk:approval>{"title": "SUP41 생산 변경정보 지원 지시 — 책임 인수", "answered_by_as": "SUP41인수자", "answered_via_as": "SUP41인수경로", "assignees": "SUP41책임자", "description": "범위·기대효과·예산·계획 제출기한·완료기한·선행조건을 보고 인수한다. 조건부 과제는 조건 미충족 표시를 유지한 채 인수할 수 있다 — 실행 착수는 조건 충족 뒤다. 불명확하면 사유와 함께 반려한다.", "show": ["SUP41배정버전", "승인서ID", "error_message"], "fields": [{"key": "SUP41결정", "label": "인수 여부", "type": "choice", "required": true, "choices": ["인수", "반려"]}, {"key": "SUP41사유", "label": "의견 (반려면 필수)", "type": "text"}]}</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="Record_Accept_SUP41" name="SUP41 인수 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{"app_id": "nowview-sc04", "operation": "accept", "input": {"demo_run_id": "데모실행ID", "node_id": "'Accept_SUP41'", "target": "'SUP41'", "decision": "SUP41결정", "reason": "SUP41사유", "version": "SUP41배정버전", "answered_by": "SUP41인수자", "answered_via": "SUP41인수경로"}, "output": {"error_message": "error_message"}}</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="Revise_SUP41" name="SUP41 보완">
      <bpmn:extensionElements>
        <chk:approval>{"title": "SUP41 반려 — 승인 범위 안 보완", "answered_by_as": "SUP41보완자", "answered_via_as": "SUP41보완경로", "assignees": ["강민서"], "description": "반려 사유에 답해 승인 범위 안에서 설명·조건을 명확히 하고 새 배정버전으로 다시 낸다. 범위·책임·한도·기한을 바꾸는 중대 변경은 대표 재확인(새 승인 버전)이다.", "show": ["SUP41배정버전", "error_message"], "fields": [{"key": "SUP41보완사유", "label": "변경 사유", "type": "text", "required": true}, {"key": "SUP41보완내용", "label": "보완 내용", "type": "text", "required": true}]}</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="Record_Revise_SUP41" name="SUP41 보완 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{"app_id": "nowview-sc04", "operation": "revise_assignment", "input": {"demo_run_id": "데모실행ID", "node_id": "'Revise_SUP41'", "target": "'SUP41'", "reason": "SUP41보완사유", "change": "SUP41보완내용", "answered_by": "SUP41보완자", "answered_via": "SUP41보완경로"}, "output": {"SUP41책임자": "owner", "SUP41배정버전": "version", "error_message": "error_message"}}</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_SUP41" name="SUP41 인수 결과" default="Flow_sup41_accepted"/>
    <bpmn:userTask id="Accept_Overall" name="TOTAL 인수">
      <bpmn:extensionElements>
        <chk:approval>{"title": "전체 책임 + DIR41 추가 발굴 — 책임 인수", "answered_by_as": "TOTAL인수자", "answered_via_as": "TOTAL인수경로", "assignees": "TOTAL책임자", "description": "총괄 책임(전체 성과·잔여 부족 관리)과 추가 발굴 지시를 인수한다.", "show": ["TOTAL배정버전", "승인서ID", "error_message"], "fields": [{"key": "TOTAL결정", "label": "인수 여부", "type": "choice", "required": true, "choices": ["인수"]}, {"key": "TOTAL사유", "label": "의견 (반려면 필수)", "type": "text"}]}</chk:approval>
