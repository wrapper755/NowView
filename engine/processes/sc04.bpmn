<?xml version="1.0" encoding="UTF-8"?>
<!--
  SC04 — 수익성 개선 대응안 검토와 실행 승인(장면 4). 업무 흐름의 유일한 원천이다(장면 1~3과 같다).

  BPM이 쥐는 것: 순서 · 사람 대기(결과 제출·임원 확인·검증·보완·추천·보고본·보고·판단 초안·판단본·대표 결정·승인서·
  등록·책임 인수·종료) · 분기(보완 요청 · 검증 차단 · 승인 보완 · 인수 반려 · 보류 안 제외) · 장면 5 인계. 쥐지 않는 것:
  효과·잔여 부족·검증 — 서비스 태스크가 NowView 계산 서비스(`nowview-sc04`)를 부른다. 엔진은 숫자를 모른다(P413).

  단계 대응(업무설계표 SC04-S01~S14): 착수(S01, 화면 명령 — 이 그림은 착수된 검토건을 연다) → S02 결과 제출·임원 확인
  (병렬) → S03·S04 검증·보완 → S05 공동 추천 → S06 보고본 → S07 보고 → S08·S09 판단 초안·확인 → S10 대표 결정 → S11
  승인서·회의록 → S12 등록 → S13 인수 → S14 종료. 대표 질의·현업 답변·지원 지시(QA411~)와 Agent 질의 후보·회의록
  초안(AG42·AG43)은 BPM 밖의 회의 기록이다.

  **Studio 시험 실행·Center 서버 실행에서 돈다**(장면 1~3 N1~N6과 같은 틀). 서비스 태스크는 외부 확장 `nowview-sc04`
  (`chaeksas/nowview-sc04.extension.json`)의 HTTP 작업이고 본문마다 `{{run_id}}`로 데모 실행을 묶는다. 결재에 답한 사람은
  `answered_by_as`·`answered_via_as`로 받아 기록 작업에 싣는다. 기록이 거절되면 오류 경계로 **같은 결재로 되돌아간다**.
  병렬 갈래끼리 변수가 겹치지 않게 폼 칸 이름에 과제·대상을 붙였다(AT31결론 · ACT41결정 …). 금액 칸은 text다 — 빈 값을
  null로 보내지 않고 빈 글로 남겨 「누락」으로 검사한다(E404).
  역할은 `app/sc04/domain.py`의 NODE_ROLES, 결재 담당자 이름은 `chk:approval.assignees` — 시험이 맞춰 본다.
  이 파일은 손으로 고쳐도 된다 — 생성기는 남기지 않았다.
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:chk="urn:chaeksas:bpmn:1" id="Defs_sc04">
  <bpmn:error id="Err_record" name="기록 거절" errorCode="TASK_FAILED"/>
  <bpmn:process id="nowview.sc04" name="SC04 수익성 개선 대응안 검토와 실행 승인" isExecutable="true">
    <bpmn:extensionElements>
      <chk:process>{"run_location": "server", "extensions": [{"id": "nowview-sc04", "version": "&gt;=0.1.0,&lt;1"}], "inputs": [{"name": "데모실행ID", "type": "string", "required": true}]}</chk:process>
    </bpmn:extensionElements>
    <bpmn:startEvent id="Start" name="장면 4 착수"/>
    <bpmn:serviceTask id="Task_Open" name="검토건 열기">
      <bpmn:extensionElements>
        <chk:serviceCall>{"app_id": "nowview-sc04", "operation": "open_review", "input": {"demo_run_id": "데모실행ID"}, "output": {"검토ID": "review_id", "담당자명": "assignee_name"}}</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <!-- S02 CT401·CT402 분석 결과 제출(부서 책임자) → 담당 임원 확인. 네 과제가 함께 돈다. 보완 요청이면 같은 부서가 새 버전을 낸다 -->
    <bpmn:parallelGateway id="Gw_Results_Split" name="AT31 ∥ AT32 ∥ AT33 ∥ AT34"/>
    <bpmn:parallelGateway id="Gw_Results_Join" name="결과 모으기"/>
    <bpmn:userTask id="Submit_AT31" name="AT31 결과 제출">
      <bpmn:extensionElements>
        <chk:approval>{"title": "AT31 부분 공정·외주 조정 — 분석 결과 제출(RES41)", "answered_by_as": "AT31제출자", "answered_via_as": "AT31제출경로", "assignees": ["배정훈"], "description": "효과 산정 근거·가정·적용시점·비용·리스크·애로를 제출한다. 산정 가정은 함께 묶인다(가정 버전). 작성과 임원 확인은 따로 기록된다.", "show": ["검토ID", "error_message"], "fields": [{"key": "AT31결과", "label": "결과 유형", "type": "choice", "required": true, "choices": ["제출", "제외"]}, {"key": "AT31결론", "label": "결론", "type": "text", "required": true}, {"key": "AT31근거", "label": "근거 ID (;로 구분)", "type": "text", "required": true}, {"key": "AT31애로", "label": "리스크·애로·지원 요구", "type": "text"}, {"key": "AT31제외사유", "label": "제외 사유 (제외면 필수)", "type": "text"}]}</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="Record_Submit_AT31" name="AT31 결과 제출 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{"app_id": "nowview-sc04", "operation": "submit_result", "input": {"demo_run_id": "데모실행ID", "node_id": "'Submit_AT31'", "task_id": "'AT31'", "outcome": "AT31결과", "conclusion": "AT31결론", "evidence": "AT31근거", "risks": "AT31애로", "reason": "AT31제외사유", "answered_by": "AT31제출자", "answered_via": "AT31제출경로"}, "output": {"AT31결과버전": "result_ref", "error_message": "error_message"}}</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="Confirm_AT31" name="AT31 임원 확인">
      <bpmn:extensionElements>
        <chk:approval>{"title": "AT31 생산 임원 확인 — RES41", "answered_by_as": "AT31확인자", "answered_via_as": "AT31확인경로", "assignees": ["권태윤"], "description": "제출본의 근거·가정·시점·비용을 확인한다. 확인 계정·시각이 고정된다. 고칠 것이 있으면 보완 요청 — 같은 부서가 새 버전을 낸다.", "show": ["AT31결과버전", "error_message"], "fields": [{"key": "AT31확인", "label": "확인", "type": "choice", "required": true, "choices": ["확인", "보완요청"]}, {"key": "AT31확인의견", "label": "확인 의견", "type": "text", "required": true}]}</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="Record_Confirm_AT31" name="AT31 임원 확인 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{"app_id": "nowview-sc04", "operation": "confirm_result", "input": {"demo_run_id": "데모실행ID", "node_id": "'Confirm_AT31'", "task_id": "'AT31'", "decision": "AT31확인", "opinion": "AT31확인의견", "answered_by": "AT31확인자", "answered_via": "AT31확인경로"}, "output": {"error_message": "error_message"}}</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Confirm_AT31" name="AT31 확인 결과" default="Flow_AT31_confirmed"/>
    <bpmn:userTask id="Submit_AT32" name="AT32 결과 제출">
      <bpmn:extensionElements>
        <chk:approval>{"title": "AT32 구매조건·긴급구매·대체 공급업체 — 분석 결과 제출(RES42)", "answered_by_as": "AT32제출자", "answered_via_as": "AT32제출경로", "assignees": ["서도현"], "description": "효과 산정 근거·가정·적용시점·비용·리스크·애로를 제출한다. 산정 가정은 함께 묶인다(가정 버전). 작성과 임원 확인은 따로 기록된다.", "show": ["검토ID", "error_message"], "fields": [{"key": "AT32결과", "label": "결과 유형", "type": "choice", "required": true, "choices": ["제출", "제외"]}, {"key": "AT32결론", "label": "결론", "type": "text", "required": true}, {"key": "AT32근거", "label": "근거 ID (;로 구분)", "type": "text", "required": true}, {"key": "AT32애로", "label": "리스크·애로·지원 요구", "type": "text"}, {"key": "AT32제외사유", "label": "제외 사유 (제외면 필수)", "type": "text"}]}</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="Record_Submit_AT32" name="AT32 결과 제출 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{"app_id": "nowview-sc04", "operation": "submit_result", "input": {"demo_run_id": "데모실행ID", "node_id": "'Submit_AT32'", "task_id": "'AT32'", "outcome": "AT32결과", "conclusion": "AT32결론", "evidence": "AT32근거", "risks": "AT32애로", "reason": "AT32제외사유", "answered_by": "AT32제출자", "answered_via": "AT32제출경로"}, "output": {"AT32결과버전": "result_ref", "error_message": "error_message"}}</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="Confirm_AT32" name="AT32 임원 확인">
      <bpmn:extensionElements>
        <chk:approval>{"title": "AT32 구매 임원 확인 — RES42", "answered_by_as": "AT32확인자", "answered_via_as": "AT32확인경로", "assignees": ["문지후"], "description": "제출본의 근거·가정·시점·비용을 확인한다. 확인 계정·시각이 고정된다. 고칠 것이 있으면 보완 요청 — 같은 부서가 새 버전을 낸다.", "show": ["AT32결과버전", "error_message"], "fields": [{"key": "AT32확인", "label": "확인", "type": "choice", "required": true, "choices": ["확인", "보완요청"]}, {"key": "AT32확인의견", "label": "확인 의견", "type": "text", "required": true}]}</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="Record_Confirm_AT32" name="AT32 임원 확인 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{"app_id": "nowview-sc04", "operation": "confirm_result", "input": {"demo_run_id": "데모실행ID", "node_id": "'Confirm_AT32'", "task_id": "'AT32'", "decision": "AT32확인", "opinion": "AT32확인의견", "answered_by": "AT32확인자", "answered_via": "AT32확인경로"}, "output": {"error_message": "error_message"}}</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Confirm_AT32" name="AT32 확인 결과" default="Flow_AT32_confirmed"/>
    <bpmn:userTask id="Submit_AT33" name="AT33 결과 제출">
      <bpmn:extensionElements>
        <chk:approval>{"title": "AT33 고객·모델 물량 배분 — 분석 결과 제출(RES43)", "answered_by_as": "AT33제출자", "answered_via_as": "AT33제출경로", "assignees": ["박서진"], "description": "고객 생산배정 범위 안의 물량 조정 근거를 검토한 결과를 낸다. 근거가 없으면 「제외」와 사유를 적는다 — 미제출과 검토 후 제외는 다르다.", "show": ["검토ID", "error_message"], "fields": [{"key": "AT33결과", "label": "결과 유형", "type": "choice", "required": true, "choices": ["제출", "제외"]}, {"key": "AT33결론", "label": "결론", "type": "text", "required": true}, {"key": "AT33근거", "label": "근거 ID (;로 구분)", "type": "text", "required": true}, {"key": "AT33애로", "label": "리스크·애로·지원 요구", "type": "text"}, {"key": "AT33제외사유", "label": "제외 사유 (제외면 필수)", "type": "text"}]}</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="Record_Submit_AT33" name="AT33 결과 제출 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{"app_id": "nowview-sc04", "operation": "submit_result", "input": {"demo_run_id": "데모실행ID", "node_id": "'Submit_AT33'", "task_id": "'AT33'", "outcome": "AT33결과", "conclusion": "AT33결론", "evidence": "AT33근거", "risks": "AT33애로", "reason": "AT33제외사유", "answered_by": "AT33제출자", "answered_via": "AT33제출경로"}, "output": {"AT33결과버전": "result_ref", "error_message": "error_message"}}</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="Confirm_AT33" name="AT33 임원 확인">
      <bpmn:extensionElements>
        <chk:approval>{"title": "AT33 영업 임원 확인 — RES43", "answered_by_as": "AT33확인자", "answered_via_as": "AT33확인경로", "assignees": ["남유진"], "description": "제출본의 근거·가정·시점·비용을 확인한다. 확인 계정·시각이 고정된다. 고칠 것이 있으면 보완 요청 — 같은 부서가 새 버전을 낸다.", "show": ["AT33결과버전", "error_message"], "fields": [{"key": "AT33확인", "label": "확인", "type": "choice", "required": true, "choices": ["확인", "보완요청"]}, {"key": "AT33확인의견", "label": "확인 의견", "type": "text", "required": true}]}</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="Record_Confirm_AT33" name="AT33 임원 확인 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{"app_id": "nowview-sc04", "operation": "confirm_result", "input": {"demo_run_id": "데모실행ID", "node_id": "'Confirm_AT33'", "task_id": "'AT33'", "decision": "AT33확인", "opinion": "AT33확인의견", "answered_by": "AT33확인자", "answered_via": "AT33확인경로"}, "output": {"error_message": "error_message"}}</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Confirm_AT33" name="AT33 확인 결과" default="Flow_AT33_confirmed"/>
    <bpmn:userTask id="Submit_AT34" name="AT34 결과 제출">
      <bpmn:extensionElements>
        <chk:approval>{"title": "AT34 기존 부족 원인 — 분석 결과 제출(RES44)", "answered_by_as": "AT34제출자", "answered_via_as": "AT34제출경로", "assignees": ["오세린"], "description": "효과 산정 근거·가정·적용시점·비용·리스크·애로를 제출한다. 산정 가정은 함께 묶인다(가정 버전). 작성과 임원 확인은 따로 기록된다.", "show": ["검토ID", "error_message"], "fields": [{"key": "AT34결과", "label": "결과 유형", "type": "choice", "required": true, "choices": ["제출", "제외"]}, {"key": "AT34결론", "label": "결론", "type": "text", "required": true}, {"key": "AT34근거", "label": "근거 ID (;로 구분)", "type": "text", "required": true}, {"key": "AT34애로", "label": "리스크·애로·지원 요구", "type": "text"}, {"key": "AT34제외사유", "label": "제외 사유 (제외면 필수)", "type": "text"}]}</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="Record_Submit_AT34" name="AT34 결과 제출 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{"app_id": "nowview-sc04", "operation": "submit_result", "input": {"demo_run_id": "데모실행ID", "node_id": "'Submit_AT34'", "task_id": "'AT34'", "outcome": "AT34결과", "conclusion": "AT34결론", "evidence": "AT34근거", "risks": "AT34애로", "reason": "AT34제외사유", "answered_by": "AT34제출자", "answered_via": "AT34제출경로"}, "output": {"AT34결과버전": "result_ref", "error_message": "error_message"}}</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="Confirm_AT34" name="AT34 임원 확인">
      <bpmn:extensionElements>
        <chk:approval>{"title": "AT34 경영관리 임원 확인 — RES44", "answered_by_as": "AT34확인자", "answered_via_as": "AT34확인경로", "assignees": ["강민서"], "description": "제출본의 근거·가정·시점·비용을 확인한다. 확인 계정·시각이 고정된다. 고칠 것이 있으면 보완 요청 — 같은 부서가 새 버전을 낸다.", "show": ["AT34결과버전", "error_message"], "fields": [{"key": "AT34확인", "label": "확인", "type": "choice", "required": true, "choices": ["확인", "보완요청"]}, {"key": "AT34확인의견", "label": "확인 의견", "type": "text", "required": true}]}</chk:approval>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="Record_Confirm_AT34" name="AT34 임원 확인 기록">
      <bpmn:extensionElements>
        <chk:serviceCall>{"app_id": "nowview-sc04", "operation": "confirm_result", "input": {"demo_run_id": "데모실행ID", "node_id": "'Confirm_AT34'", "task_id": "'AT34'", "decision": "AT34확인", "opinion": "AT34확인의견", "answered_by": "AT34확인자", "answered_via": "AT34확인경로"}, "output": {"error_message": "error_message"}}</chk:serviceCall>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Confirm_AT34" name="AT34 확인 결과" default="Flow_AT34_confirmed"/>

    <!-- S03·S04 CT402·CT403 비용·중복 검증 — 잔존 고정비 유지, 중복 제거, 적용량·원가 한도. 차단이면 담당 임원 보완 → 재검증 -->
    <bpmn:userTask id="Verify_Effects" name="비용·중복 검증">
      <bpmn:extensionElements>
        <chk:approval>{"title": "U402 효과 검증 — 회피 비용·잔존 고정비·중복", "answered_by_as": "검증자", "answered_via_as": "검증경로", "assignees": ["정하윤"], "description": "확인된 결과의 가정으로 월별 효과를 계산하고 검증한다. 기존 감가상각비는 회피 비용이 아니다. 같은 품목·물량·기간의 절감은 한 번만. 차단 오류는 보고 확정을 막는다 — 조건부 승인으로 우회할 수 없다.", "show": ["검토ID", "error_message"], "fields": [{"key": "검증기준", "label": "공통 기준(기간·단위·기준 전망·원가 버전) 확인", "type": "choice", "required": true, "choices": ["확인"]}, {"key": "검증메모", "label": "메모", "type": "text"}]}</chk:approval>
