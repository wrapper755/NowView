{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sc01/agent_draft.schema.json",
  "title": "장면 1 agent_draft",
  "description": "AI 검토 초안 — 검증을 통과한 응답만 draft에 있다. 입력 원문·거절된 응답은 싣지 않는다(AG-01)",
  "type": "object",
  "required": [
    "output_id",
    "seq",
    "run_id",
    "status",
    "mode"
  ],
  "properties": {
    "output_id": {
      "type": "string"
    },
    "seq": {
      "type": "integer"
    },
    "run_id": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "mode": {
      "type": "string"
    },
    "agent_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Agent 이름 — 이 칸 전에 만든 기록에는 없다"
    },
    "agent_version": {
      "type": [
        "string",
        "null"
      ],
      "description": "Agent 판(러너·계약). 지시문 판은 prompt_version"
    },
    "execution_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "실행 id(AGX-…) — 산출물 번호 output_id와 다르다. 자동 재시도 두 번은 한 실행"
    },
    "model_called": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "실제 모델을 불렀는가 — mock·fail은 false(준비된 결과 재현)"
    },
    "draft": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "summary"
          ],
          "properties": {
            "summary": {
              "type": "string"
            },
            "findings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "questions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "errors": {
      "type": "array",
      "items": {}
    },
    "input": false,
    "rejected": false
  },
  "additionalProperties": true
}
