{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "s3/sc01/fix_request.schema.json",
  "title": "s3/sc01 fix_request",
  "description": "보완 요청 — 대상 시트·행·기대값·확인값·보완 담당·기한·해소 버전",
  "type": "object",
  "required": [
