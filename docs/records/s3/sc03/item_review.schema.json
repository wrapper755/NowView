{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "s3/sc03/item_review.schema.json",
  "title": "s3/sc03 item_review",
  "description": "보완 재검토 — 참조 보강 재검토·재계산 뒤 영향 항목 검토·승계",
  "type": "object",
  "required": [
    "carried_from",
    "diff_won",
    "file_id",
    "item",
    "note",
    "paths",
    "request",
    "result_version",
    "review_id",
    "reviewed_at",
    "reviewed_by",
    "reviewed_via",
    "state",
    "valid",
    "work_id"
  ],
  "properties": {
    "review_id": {
      "type": "string"
    },
    "item": {
      "type": "string"
    },
    "work_id": {
      "type": "string"
    },
    "result_version": {
      "type": "string"
    },
    "file_id": {
      "type": "string"
    },
    "reviewed_by": {
      "type": "string"
    },
    "reviewed_via": {
      "type": "null"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "request": {
      "type": "string",
      "pattern": "^-?\\d+(\\.\\d+)?(E-?\\d+)?$"
    },
    "diff_won": {
      "type": "integer"
    },
    "carried_from": {
      "type": [
        "null",
        "string"
      ]
    },
    "state": {
      "type": "string"
    },
    "valid": {
      "type": "boolean"
    },
    "note": {
      "type": [
        "null",
        "string"
      ]
    }
  },
  "additionalProperties": true
}
