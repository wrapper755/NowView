{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "s3/sc03/scene.schema.json",
  "title": "s3/sc03 scene",
  "description": "장면 머리 — 시연 시각·실행 위치·BPM 실행(지나온 노드·대기)·장면 2 인계·현재 보고 버전·결정 보류·입력 변경 알림·흐름 01~06·회사와 오간 것",
  "type": "object",
  "required": [
    "approver",
    "bpm",
    "caseId",
    "clock",
    "close",
    "companyLog",
    "decisions",
    "demoRunId",
    "entry",
    "executor",
    "flow",
    "handoff",
    "hold",
    "holds",
    "input_notice",
    "latest_result",
    "report",
    "scenario",
    "scene",
    "title"
  ],
  "properties": {
    "demoRunId": {
      "type": "string"
    },
    "scenario": {
      "type": "string"
    },
    "scene": {
      "type": "integer"
    },
    "title": {
      "type": "string"
    },
    "caseId": {
      "type": "string"
    },
    "clock": {
      "type": "string",
      "format": "date-time"
    },
    "executor": {
      "type": "string"
    },
    "bpm": {
      "type": "object",
      "required": [
        "external_run_id",
        "job_id",
        "problem",
        "state",
        "visited",
        "waiting"
      ],
      "properties": {
        "state": {
          "type": "string"
        },
        "job_id": {
          "type": "null"
        },
        "external_run_id": {
          "type": [
            "null",
            "string"
          ]
        },
        "visited": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "waiting": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "node_id",
              "title"
            ],
            "properties": {
              "node_id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "problem": {
          "type": "null"
        }
      },
      "additionalProperties": true
    },
    "close": {
      "type": "object",
      "required": [
        "allowed_sheets",
        "close_id",
        "comparative_end",
        "dataset_version",
        "excluded_sheets",
        "period_end",
        "reviewer",
        "schedule",
        "title",
        "unit"
      ],
      "properties": {
        "close_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "period_end": {
          "type": "string"
        },
        "comparative_end": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "reviewer": {
          "type": "object",
          "required": [
            "name",
            "role",
            "user_id"
          ],
          "properties": {
            "role": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "user_id": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "schedule": {
          "type": "object",
          "required": [
            "approve_due",
            "posting_due",
            "started",
            "submit_due"
          ],
          "properties": {
            "started": {
              "type": "string",
              "format": "date-time"
            },
            "submit_due": {
              "type": "string",
              "format": "date-time"
            },
            "approve_due": {
              "type": "string",
              "format": "date-time"
            },
            "posting_due": {
              "type": "string",
              "format": "date-time"
            }
          },
          "additionalProperties": true
        },
        "dataset_version": {
          "type": "string"
        },
        "allowed_sheets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excluded_sheets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "approver": {
      "type": "object",
      "required": [
        "name",
        "role",
        "user_id"
      ],
      "properties": {
        "role": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "user_id": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "entry": {
      "type": "object",
      "required": [
        "handoff_id",
        "opened_at",
        "report_id",
        "report_version"
      ],
      "properties": {
        "handoff_id": {
          "type": "string"
        },
        "report_id": {
          "type": "string"
        },
        "report_version": {
          "type": "integer"
        },
        "opened_at": {
          "type": [
            "null",
            "string"
          ],
          "format": "date-time"
        }
      },
      "additionalProperties": true
    },
    "report": {
      "type": "object",
      "required": [
        "approval_scope",
        "file_id",
        "record_id",
        "report_id",
        "result_version",
        "state",
        "version"
      ],
      "properties": {
        "report_id": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        },
        "record_id": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "result_version": {
          "type": "string"
        },
        "file_id": {
          "type": "string"
        },
        "approval_scope": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "latest_result": {
      "type": "string"
    },
    "hold": {
      "type": [
        "null",
        "object"
      ],
      "required": [
        "at",
        "by",
        "decision",
        "reason",
        "recovery_owner",
        "report_version",
        "status"
      ],
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "by": {
          "type": "string"
        },
        "decision": {
          "type": "string"
        },
        "report_version": {
          "type": "string",
          "pattern": "^-?\\d+(\\.\\d+)?(E-?\\d+)?$"
        },
        "status": {
          "type": "integer"
        },
        "reason": {
          "type": "string"
        },
        "recovery_owner": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "holds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "at",
          "by",
          "decision",
          "reason",
          "recovery_owner",
          "report_version",
          "status"
        ],
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "by": {
            "type": "string"
          },
          "decision": {
            "type": "string"
          },
          "report_version": {
            "type": "string",
            "pattern": "^-?\\d+(\\.\\d+)?(E-?\\d+)?$"
          },
          "status": {
            "type": "integer"
          },
          "reason": {
            "type": "string"
          },
          "recovery_owner": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "input_notice": {
      "type": [
        "null",
        "object"
      ],
      "required": [
        "input_version",
        "reason",
        "report_input"
      ],
      "properties": {
        "input_version": {
          "type": "string"
        },
        "report_input": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "flow": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "role",
          "state",
          "step"
        ],
        "properties": {
          "step": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "state": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "companyLog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "at",
          "direction",
          "what"
        ],
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "direction": {
            "type": "string"
          },
          "what": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "handoff": {
      "type": [
        "null",
        "string"
      ]
    }
  },
  "additionalProperties": true
}
