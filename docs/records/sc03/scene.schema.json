{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sc03/scene.schema.json",
  "title": "장면 3 scene",
  "description": "장면 머리 — 시연 시각·상태 묶음·장면 2 결과 스냅샷·일정·인수율·완료 요건·알림·회사와 오간 것",
  "type": "object",
  "required": [
    "acceptance",
    "agentMode",
    "alerts",
    "bpm",
    "caseId",
    "caseLabel",
    "clock",
    "companyLog",
    "currentDraftId",
    "delayed",
    "demoRunId",
    "executor",
    "freezeProblems",
    "frozenReportId",
    "latestRunId",
    "revisions",
    "sc02",
    "schedule",
    "status",
    "step"
  ],
  "properties": {
    "demoRunId": {
      "type": "string"
    },
    "caseId": {
      "type": "string"
    },
    "caseLabel": {
      "type": "string"
    },
    "clock": {
      "type": "string",
      "format": "date-time"
    },
    "step": {
      "type": "string"
    },
    "status": {
      "type": "object",
      "required": [
        "forecast",
        "outcome",
        "review",
        "risk",
        "scene",
        "target"
      ],
      "properties": {
        "review": {
          "type": "string"
        },
        "outcome": {
          "type": [
            "null",
            "string"
          ]
        },
        "risk": {
          "type": "string"
        },
        "forecast": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "scene": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "sc02": {
      "type": "object",
      "required": [
        "cost",
        "demo_run_id",
        "executor",
        "forecast_approval",
        "handoff",
        "issues",
        "price",
        "request_price",
        "sc01_run"
      ],
      "properties": {
        "demo_run_id": {
          "type": "string"
        },
        "executor": {
          "type": "string"
        },
        "handoff": {
          "type": "object",
          "required": [
            "accepted_at",
            "accepted_by",
            "bundle_hash",
            "bundle_id",
            "handoff_id",
            "sc03_due_at",
            "selected_run"
          ],
          "properties": {
            "handoff_id": {
              "type": "string"
            },
            "bundle_id": {
              "type": "string"
            },
            "bundle_hash": {
              "type": "string"
            },
            "selected_run": {
              "type": "string"
            },
            "accepted_by": {
              "type": "string"
            },
            "accepted_at": {
              "type": "string",
              "format": "date-time"
            },
            "sc03_due_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "additionalProperties": true
        },
        "price": {
          "type": "object",
          "required": [
            "effective_date",
            "new_price",
            "old_price",
            "part_id",
            "run_id",
            "version_id"
          ],
          "properties": {
            "version_id": {
              "type": "string"
            },
            "part_id": {
              "type": "string"
            },
            "old_price": {
              "type": "string",
              "pattern": "^-?\\d+(\\.\\d+)?(E-?\\d+)?$"
            },
            "new_price": {
              "type": "string",
              "pattern": "^-?\\d+(\\.\\d+)?(E-?\\d+)?$"
            },
            "effective_date": {
              "type": "string"
            },
            "run_id": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "request_price": {
          "type": "string",
          "pattern": "^-?\\d+(\\.\\d+)?(E-?\\d+)?$"
        },
        "cost": {
          "type": "object",
          "required": [
            "cost_version_id",
            "effective_from",
            "parent_cost_version",
            "registered_at"
          ],
          "properties": {
            "cost_version_id": {
              "type": "string"
            },
            "parent_cost_version": {
              "type": "string"
            },
            "effective_from": {
              "type": "string"
            },
            "registered_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "additionalProperties": true
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "issue_id",
              "risk",
              "run_id",
              "status",
              "summary",
              "type"
            ],
            "properties": {
              "issue_id": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "risk": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "run_id": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "sc01_run": {
          "type": "string"
        },
        "forecast_approval": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "schedule": {
      "type": "object",
      "required": [
        "accept_due",
        "confirm_due",
        "consolidate_due",
        "freeze_at",
        "meeting_at",
        "meeting_end",
        "next_meeting_at",
        "submit_due"
      ],
      "properties": {
        "confirm_due": {
          "type": "string",
          "format": "date-time"
        },
        "freeze_at": {
          "type": "string",
          "format": "date-time"
        },
        "meeting_at": {
          "type": "string",
          "format": "date-time"
        },
        "meeting_end": {
          "type": "string",
          "format": "date-time"
        },
        "accept_due": {
          "type": "string",
          "format": "date-time"
        },
        "submit_due": {
          "type": "string",
          "format": "date-time"
        },
        "consolidate_due": {
          "type": "string",
          "format": "date-time"
        },
        "next_meeting_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": true
    },
    "latestRunId": {
      "type": [
        "null",
        "string"
      ]
    },
    "currentDraftId": {
      "type": [
        "null",
        "string"
      ]
    },
    "frozenReportId": {
      "type": [
        "null",
        "string"
      ]
    },
    "freezeProblems": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance": {
      "type": "object",
      "required": [
        "accepted",
        "assigned",
        "rate"
      ],
      "properties": {
        "assigned": {
          "type": "integer"
        },
        "accepted": {
          "type": "integer"
        },
        "rate": {
          "type": [
            "null",
            "string"
          ],
          "pattern": "^-?\\d+(\\.\\d+)?(E-?\\d+)?$"
        }
      },
      "additionalProperties": true
    },
    "delayed": {
      "type": "array"
    },
    "revisions": {
      "type": "array"
    },
    "executor": {
      "type": "string"
    },
    "agentMode": {
      "type": "string"
    },
    "alerts": {
      "type": "array"
    },
    "companyLog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "at",
          "by",
          "direction",
          "doc_id",
          "seq",
          "what"
        ],
        "properties": {
          "seq": {
            "type": "integer"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "direction": {
            "type": "string"
          },
          "what": {
            "type": "string"
          },
          "doc_id": {
            "type": "string"
          },
          "by": {
            "type": "null"
          }
        },
        "additionalProperties": true
      }
    },
    "bpm": {
      "type": [
        "null",
        "object"
      ],
      "required": [
        "executor",
        "externalRunId",
        "state",
        "visited"
      ],
      "properties": {
        "executor": {
          "type": "string"
        },
        "externalRunId": {
          "type": "null"
        },
        "state": {
          "type": "string"
        },
        "visited": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
