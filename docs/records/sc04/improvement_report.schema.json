{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sc04/improvement_report.schema.json",
  "title": "장면 4 improvement_report",
  "description": "보고본·판단본(REP41·DEC41) — 결론·스냅샷 숫자(U404)",
  "type": "object",
  "required": [
    "content_hash",
    "frozen_at",
    "frozen_by",
    "kind",
    "parent",
    "report_id",
    "run_id",
    "seq",
    "status"
  ],
  "properties": {
    "report_id": {
      "type": "string"
    },
    "seq": {
      "type": "integer"
    },
    "kind": {
      "type": "string"
    },
    "parent": {
      "type": [
        "null",
        "string"
      ]
    },
    "status": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "recommendation": {
      "type": "string"
    },
    "conclusion": {
      "type": "string"
    },
    "snapshot": {
      "type": "object",
      "required": [
        "assumptions_hash",
        "effect",
        "gap",
        "run_id"
      ],
      "properties": {
        "run_id": {
          "type": "string"
        },
        "assumptions_hash": {
          "type": "string"
        },
        "recommended": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "results": {
          "type": "object",
          "required": [
            "RES41",
            "RES42",
            "RES43",
            "RES44"
          ],
          "properties": {
            "RES41": {
              "type": "string"
            },
            "RES42": {
              "type": "string"
            },
            "RES43": {
              "type": "string"
            },
            "RES44": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "confirmations": {
          "type": "object",
          "required": [
            "RES41",
            "RES42",
            "RES43",
            "RES44"
          ],
          "properties": {
            "RES41": {
              "type": "string"
            },
            "RES42": {
              "type": "string"
            },
            "RES43": {
              "type": "string"
            },
            "RES44": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "gap_before": {
          "type": "string",
          "pattern": "^-?\\d+(\\.\\d+)?(E-?\\d+)?$"
        },
        "effect": {
          "type": "string",
          "pattern": "^-?\\d+(\\.\\d+)?(E-?\\d+)?$"
        },
        "gap": {
          "type": "string",
          "pattern": "^-?\\d+(\\.\\d+)?(E-?\\d+)?$"
        },
        "parent": {
          "type": "string"
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "after",
              "alt_id",
              "before",
              "field",
              "label"
            ],
            "properties": {
              "alt_id": {
                "type": "string"
              },
              "field": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "before": {
                "type": "string"
              },
              "after": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "content_hash": {
      "type": [
        "null",
        "string"
      ]
    },
    "frozen_by": {
      "type": [
        "null",
        "string"
      ]
    },
    "frozen_at": {
      "type": [
        "null",
        "string"
      ],
      "format": "date-time"
    },
    "distribution": {
      "type": "object",
      "required": [
        "at",
        "by",
        "memo",
        "recipients"
      ],
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "by": {
          "type": "string"
        },
        "recipients": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "memo": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "after",
          "alt_id",
          "before",
          "field",
          "label"
        ],
        "properties": {
          "alt_id": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "before": {
            "type": "string"
          },
          "after": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "reason": {
      "type": "string"
    },
    "change_confirmed_by": {
      "type": "string"
    },
    "diff": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "after",
          "alt_id",
          "before",
          "diff",
          "start_after",
          "start_before"
        ],
        "properties": {
          "alt_id": {
            "type": "string"
          },
          "start_before": {
            "type": "string"
          },
          "start_after": {
            "type": "string"
          },
          "before": {
            "type": "string",
            "pattern": "^-?\\d+(\\.\\d+)?(E-?\\d+)?$"
          },
          "after": {
            "type": "string",
            "pattern": "^-?\\d+(\\.\\d+)?(E-?\\d+)?$"
          },
          "diff": {
            "type": "string",
            "pattern": "^-?\\d+(\\.\\d+)?(E-?\\d+)?$"
          }
        },
        "additionalProperties": true
      }
    },
    "created_by": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "opinion": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
