{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sc04/followup_question.schema.json",
  "title": "장면 4 followup_question",
  "description": "장면 3에서 넘어온 쟁점(Q31·Q32) — 담당·기한·처리·이력",
  "type": "object",
  "required": [
    "due_at",
    "history",
    "owner",
    "question",
    "question_id",
    "state",
    "treatment"
  ],
  "properties": {
    "question_id": {
      "type": "string"
    },
    "question": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "due_at": {
      "type": "string",
      "format": "date-time"
    },
    "treatment": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "at",
          "note"
        ],
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "note": {
            "type": "string"
          },
          "by": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
