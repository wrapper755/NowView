{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sc04/agent_draft.schema.json",
  "title": "장면 4 agent_draft",
  "description": "AI 초안 — 검증을 통과한 응답만(거절 응답·입력 원문 없음)",
  "type": "object",
  "required": [
    "adopted_at",
    "adopted_by",
    "created_at",
    "draft",
    "errors",
    "input_hash",
    "kind",
    "mode",
    "output_id",
    "prompt_version",
    "review_status",
    "seq",
    "source_version",
    "status"
  ],
  "properties": {
    "output_id": {
      "type": "string"
    },
    "seq": {
      "type": "integer"
    },
    "kind": {
      "type": "string"
    },
    "prompt_version": {
      "type": "string"
    },
    "mode": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string"
    },
    "draft": {
      "type": "object",
      "required": [
        "draft_text",
        "findings",
        "questions",
        "summary"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "evidence_refs",
              "text"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": true
          }
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "draft_text": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "errors": {
      "type": "array"
    },
    "source_version": {
      "type": "string"
    },
    "input_hash": {
      "type": "string"
    },
    "adopted_by": {
      "type": "null"
    },
    "adopted_at": {
      "type": "null"
    },
    "review_status": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
