{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "s2/sc03/scene.schema.json",
  "title": "s2/sc03 scene",
  "description": "장면 머리 — 시연 시각·사례·실행 위치·BPM 실행·장면 2 인계 사본·회사와 오간 것",
  "type": "object",
  "required": [
    "bpm",
    "caseId",
    "clock",
    "companyLog",
    "demoRunId",
    "executor",
    "flow",
    "handoff",
    "reReports",
    "scenario",
    "scene",
    "source",
    "title"
  ],
  "properties": {
    "demoRunId": {
      "type": "string"
    },
    "scenario": {
      "type": "string"
    },
    "scene": {
      "type": "integer"
    },
    "title": {
      "type": "string"
    },
    "caseId": {
      "type": "string"
    },
    "clock": {
      "type": "string",
      "format": "date-time"
    },
    "executor": {
      "type": "string"
    },
    "bpm": {
      "type": "object",
      "required": [
        "external_run_id",
        "job_id",
        "problem",
        "state",
        "visited",
        "waiting"
      ],
      "properties": {
        "job_id": {
          "type": "null"
        },
        "external_run_id": {
          "type": [
            "null",
            "string"
          ]
        },
        "state": {
          "type": "string"
        },
        "visited": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "waiting": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "node_id",
              "title"
            ],
            "properties": {
              "node_id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "problem": {
          "type": "null"
        }
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "required": [
        "approval_id",
        "case_id",
        "commitments",
        "handoff_id",
        "observed",
        "production_plan_version"
      ],
      "properties": {
        "handoff_id": {
          "type": "string"
        },
        "case_id": {
          "type": "string"
        },
        "commitments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "observed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "production_plan_version": {
          "type": "string"
        },
        "approval_id": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "flow": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "node",
          "role",
          "state"
        ],
        "properties": {
          "node": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "state": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "companyLog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "at",
          "direction",
          "what"
        ],
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "direction": {
            "type": "string"
          },
          "what": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "handoff": {
      "type": [
        "null",
        "string"
      ]
    },
    "reReports": {
      "type": "integer"
    }
  },
  "additionalProperties": true
}
