            "arrival",
            "cutoff",
            "departure",
            "promised_at",
            "qty",
            "ready_at",
            "shortfall_min",
            "truck_id"
          ],
          "properties": {
            "truck_id": {
              "type": "string"
            },
            "cutoff": {
              "type": "string",
              "format": "date-time"
            },
            "departure": {
              "type": "string",
              "format": "date-time"
            },
            "arrival": {
              "type": "string",
              "format": "date-time"
            },
            "ready_at": {
              "type": "string",
              "format": "date-time"
            },
            "promised_at": {
              "type": "string",
              "format": "date-time"
            },
            "shortfall_min": {
              "type": "integer"
            },
            "qty": {
              "type": "integer"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "kept": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "case_state": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
