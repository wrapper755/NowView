          "ref_owner_role": {
            "type": [
              "null",
              "string"
            ]
          },
          "activation": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "proposed_at": {
      "type": "string",
      "format": "date-time"
    },
    "proposed_by": {
      "type": "string"
    },
    "execution_mode": {
      "type": "string"
    },
    "check": {
      "type": [
        "null",
