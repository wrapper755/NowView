              "type": "string"
            }
          },
          "selection": {
            "type": "string"
          },
          "delegation": {
            "type": [
              "null",
              "string"
            ]
          },
          "owner": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "predecessor": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "link_mode": {
            "type": "string"
          },
          "carried_from": {
            "type": [
              "null",
              "string"
            ]
          },
          "carried_state": {
            "type": [
              "null",
              "string"
            ]
          },
          "target": {
            "type": [
