        "case_id": {
          "type": "string"
        },
        "handoff_id": {
          "type": "string"
        },
        "commitments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "observed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "production_plan_version": {
          "type": "string"
        },
        "approval_id": {
          "type": "string"
        },
        "regular": {
          "type": "object",
