{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "s2/sc03/dashboard.schema.json",
  "title": "s2/sc03 dashboard",
  "description": "납기 상황판(UI-D01) 장면 3 몫 — 두 안의 여유·긴급 추가비(견적)·한도 초과·결정·과제·마감 OTD",
  "type": "object",
  "required": [
    "as_of",
    "case_id",
    "comparison",
    "dataset_version",
    "kpi",
    "notice",
    "re_reports",
    "scope",
    "summary"
  ],
  "properties": {
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "type": "object",
      "required": [
        "company",
        "plant",
        "product"
      ],
      "properties": {
        "company": {
          "type": "string"
        },
        "plant": {
          "type": "string"
        },
        "product": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "dataset_version": {
      "type": "string"
    },
    "kpi": {
      "type": "object",
      "required": [
        "by_model",
        "denominator",
        "late",
        "meets_target",
        "numerator",
        "otd",
        "period",
        "target"
      ],
      "properties": {
        "period": {
          "type": "object",
          "required": [
            "end",
            "label",
            "start"
          ],
          "properties": {
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            },
            "label": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "numerator": {
          "type": "integer"
        },
        "denominator": {
          "type": "integer"
        },
        "otd": {
          "type": "string",
          "pattern": "^-?\\d+(\\.\\d+)?(E-?\\d+)?$"
        },
        "target": {
          "type": "string",
          "pattern": "^-?\\d+(\\.\\d+)?(E-?\\d+)?$"
        },
        "meets_target": {
          "type": "boolean"
        },
        "late": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "by_model": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "due",
              "model",
              "on_time",
              "otd"
            ],
            "properties": {
              "model": {
                "type": "string"
              },
              "due": {
                "type": "integer"
              },
              "on_time": {
                "type": "integer"
              },
              "otd": {
                "type": "string",
                "pattern": "^-?\\d+(\\.\\d+)?(E-?\\d+)?$"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": [
        "action",
        "decision",
        "express_excess",
        "express_extra_cost",
        "express_margin_min",
        "regular_margin_min"
      ],
      "properties": {
        "regular_margin_min": {
          "type": [
            "integer",
            "null"
          ]
        },
        "express_margin_min": {
          "type": [
            "integer",
            "null"
          ]
        },
        "express_extra_cost": {
          "type": [
            "integer",
            "null"
          ]
        },
        "express_excess": {
          "type": [
            "integer",
            "null"
          ]
        },
        "decision": {
          "type": [
            "null",
            "string"
          ]
        },
        "action": {
          "type": [
            "null",
            "string"
          ]
        }
      },
      "additionalProperties": true
    },
    "comparison": {
      "type": [
        "null",
        "string"
      ]
    },
    "case_id": {
      "type": "string"
    },
    "re_reports": {
      "type": "integer"
    },
    "notice": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
