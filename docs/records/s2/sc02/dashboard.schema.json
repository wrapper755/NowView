{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "s2/sc02/dashboard.schema.json",
  "title": "s2/sc02 dashboard",
  "description": "납기 상황판(UI-D01) 장면 2 몫 — 마감 OTD·최초 영향·대조 일치·관찰·잔여 위험·보류·확인",
  "type": "object",
  "required": [
    "as_of",
    "case_id",
    "dataset_version",
    "kpi",
    "notice",
    "orders",
    "scope",
    "summary"
  ],
  "properties": {
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "type": "object",
      "required": [
        "company",
        "plant",
        "product"
      ],
      "properties": {
        "company": {
          "type": "string"
        },
        "plant": {
          "type": "string"
        },
        "product": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "dataset_version": {
      "type": "string"
    },
    "kpi": {
      "type": "object",
      "required": [
        "by_model",
        "denominator",
        "late",
        "meets_target",
        "numerator",
        "otd",
        "period",
        "target"
      ],
      "properties": {
        "period": {
          "type": "object",
          "required": [
            "end",
            "label",
            "start"
          ],
          "properties": {
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            },
            "label": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "numerator": {
          "type": "integer"
        },
        "denominator": {
          "type": "integer"
        },
        "otd": {
          "type": "string",
          "pattern": "^-?\\d+(\\.\\d+)?(E-?\\d+)?$"
        },
        "target": {
          "type": "string",
          "pattern": "^-?\\d+(\\.\\d+)?(E-?\\d+)?$"
        },
        "meets_target": {
          "type": "boolean"
        },
        "late": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "by_model": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "due",
              "model",
              "on_time",
              "otd"
            ],
            "properties": {
              "model": {
                "type": "string"
              },
              "due": {
                "type": "integer"
              },
              "on_time": {
                "type": "integer"
              },
              "otd": {
                "type": "string",
                "pattern": "^-?\\d+(\\.\\d+)?(E-?\\d+)?$"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": [
        "confirmations",
        "hold",
        "initial_impact",
        "matched",
        "observe",
        "residual"
      ],
      "properties": {
        "initial_impact": {
          "type": "integer"
        },
        "matched": {
          "type": "integer"
        },
        "observe": {
          "type": "integer"
        },
        "residual": {
          "type": "integer"
        },
        "hold": {
          "type": "integer"
        },
        "confirmations": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    },
    "orders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "commitment_id",
          "margin_min",
          "route",
          "route_label"
        ],
        "properties": {
          "commitment_id": {
            "type": "string"
          },
          "route": {
            "type": "string"
          },
          "route_label": {
            "type": "string"
          },
          "margin_min": {
            "type": "integer"
          }
        },
        "additionalProperties": true
      }
    },
    "case_id": {
      "type": "string"
    },
    "notice": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
