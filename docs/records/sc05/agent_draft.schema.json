{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sc05/agent_draft.schema.json",
  "title": "장면 5 agent_draft",
  "description": "AI 초안(AG51~58) — 고정 초안 재생(REPLAY)·사람 검토 기록",
  "type": "object",
  "required": [
    "created_at",
    "draft",
    "errors",
    "kind",
    "mode",
    "model_version",
    "output_id",
    "prompt_version",
    "review_status",
    "reviewed_at",
    "reviewed_by",
    "seq",
    "source_hash",
    "status"
  ],
  "properties": {
    "output_id": {
      "type": "string"
    },
    "seq": {
      "type": "integer"
    },
    "kind": {
      "type": "string"
    },
    "prompt_version": {
      "type": "string"
    },
    "model_version": {
      "type": "string"
    },
    "mode": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string"
    },
    "draft": {
      "type": "object",
      "required": [
        "draft_text",
        "findings",
        "questions",
        "summary"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "evidence_refs",
              "text"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": true
          }
        },
        "questions": {
          "type": "array"
        },
        "draft_text": {
          "type": "string"
        },
        "activities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "activity_id",
              "completion",
              "cooperation",
              "cost",
              "end",
              "evidence",
              "name",
              "owner",
              "predecessors",
              "start"
            ],
            "properties": {
              "activity_id": {
                "type": "string",
                "pattern": "^-?\\d+(\\.\\d+)?(E-?\\d+)?$"
              },
              "name": {
                "type": "string"
              },
              "owner": {
                "type": "string"
              },
              "start": {
                "type": "string"
              },
              "end": {
                "type": "string"
              },
              "predecessors": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^-?\\d+(\\.\\d+)?(E-?\\d+)?$"
                }
              },
              "cooperation": {
                "type": "null"
              },
              "cost": {
                "type": "null"
              },
              "completion": {
                "type": "string"
              },
              "evidence": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "errors": {
      "type": "array"
    },
    "source_hash": {
      "type": "string"
    },
    "review_status": {
      "type": "string"
    },
    "reviewed_by": {
      "type": [
        "null",
        "string"
      ]
    },
    "reviewed_at": {
      "type": [
        "null",
        "string"
      ],
      "format": "date-time"
    },
    "review_note": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
