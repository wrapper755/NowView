# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python 엔진 (engine/)
# uv.lock은 커밋한다 — package-lock.json과 같은 이유로 재현성이 필요하다.
engine/.venv/
# C15 일꾼 토큰 — Center가 승인해 봉해 준 원문이 들어 있다(engine/app/consumer.py)
engine/.consumer/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
# LangGraph checkpointer 상태. 인스턴스 진행 상황이라 커밋 대상이 아니다.
# `-wal`·`-shm` 사이드카까지 잡아야 한다 — `*.sqlite`만 두었다가 그 둘을 커밋했다.
engine/*.sqlite
engine/*.sqlite-*

# 편집기 스왑·백업 파일 (한 번 실수로 커밋했다)
*.swp
*.swo
*~

# 로컬 개발 프로세스 제어(scripts/stack.sh)의 PID·로그
.dev/
